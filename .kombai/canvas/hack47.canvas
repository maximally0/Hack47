  "nodes": {
    "var_8efb54de8991": {
      "type": "variant",
      "label": "V1 — Sixteen Lights (editorial brutalist)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root{\n  --coal:#080807;\n  --soot:#1A1815;\n  --chalk:#F2EFE8;\n  --volt:#285AF7;\n  --volt-dp:#1B3FB4;\n  --line:rgba(242,239,232,.14);\n}\n.d{font-family:'Archivo',system-ui,sans-serif;}\n.m{font-family:'DM Mono',ui-monospace,monospace;}\n.lbl{font-family:'DM Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;}\n.tnum{font-variant-numeric:tabular-nums;}\n.ap{position:relative;overflow:hidden;}\n.ap-fill{position:absolute;inset:0;background:var(--volt);opacity:0;}\n.hero-ap{border:1px solid rgba(242,239,232,.28);}\n.hero-ap .glow{position:absolute;inset:0;background:linear-gradient(180deg,rgba(40,90,247,.92),rgba(40,90,247,.22));opacity:0;}\n.rule{height:1px;background:var(--line);}\n.rule-dk{height:1px;background:rgba(8,8,7,.18);}\n.btn-o{background:var(--volt);color:var(--chalk);border-radius:0;}\n.btn-o .ar{display:inline-block;transition:transform .18s ease;}\n.btn-o:hover .ar{transform:translateX(5px);}\n.btn-k{background:#0B0A09;color:var(--chalk);border-radius:0;}\n.btn-k .ar{display:inline-block;transition:transform .18s ease;}\n.btn-k:hover .ar{transform:translateX(5px);}\n.ulink{text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px;}\n.ph{filter:grayscale(.35) contrast(1.05) brightness(.82);}\n\n/* selection field */\n.sel-cell{width:100%;height:100%;}\n\n/* mentor slider */\n#mtrack{scrollbar-width:none;-ms-overflow-style:none;scroll-snap-type:x mandatory;}\n#mtrack::-webkit-scrollbar{display:none;}\n.mcard{scroll-snap-align:start;flex:0 0 clamp(272px,29vw,376px);}\n.mcard-img{transition:filter .4s ease,transform .5s ease;}\n.mcard:hover .mcard-img{filter:grayscale(0) contrast(1.02);transform:scale(1.03);}\n.sbtn{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(8,8,7,.24);background:transparent;color:#0B0A09;cursor:pointer;transition:background .2s ease,color .2s ease,border-color .2s ease;}\n.sbtn:hover{background:var(--volt);border-color:var(--volt);color:var(--chalk);}\n\n/* partner wall */\n.logo-cell{display:flex;align-items:center;justify-content:center;gap:9px;height:78px;opacity:.5;transition:opacity .25s ease;}\n.logo-cell:hover{opacity:1;}\n.logo-cell img{filter:invert(1);width:22px;height:22px;flex:none;}\n.logo-cell span{font-size:14px;letter-spacing:-.01em;color:var(--chalk);white-space:nowrap;}\n.pill{background:var(--chalk);color:#0B0A09;border-radius:999px;transition:transform .2s ease;}\n.pill:hover{transform:translateY(-2px);}\n\n/* clock */\n.tick{flex:1;height:100%;background:rgba(242,239,232,.24);}\n.tick-on{background:var(--chalk);}\n.clock-row:hover .clock-key{color:var(--chalk);}\n.clock-key{transition:color .2s ease;}\n\n/* footer */\n.fmark{background:rgba(242,239,232,.16);}\n.flink{color:rgba(242,239,232,.72);text-decoration:none;transition:color .2s ease,padding-left .2s ease;}\n.flink:hover{color:var(--volt);}\n\n/* selection funnel */\n#selFunnel{display:block;width:100%;height:100%;}\n\n/* hackathons */\n.hk-row{transition:background .22s ease;}\n.hk-row:hover{background:rgba(8,8,7,.045);}\n.hk-row:hover .hk-city{color:var(--volt);}\n.hk-city{transition:color .22s ease;}\n.hk-status{border:1px solid rgba(8,8,7,.28);}\n.hk-status-live{background:var(--volt);color:var(--chalk);border-color:var(--volt);}\n.hk-num{font-variant-numeric:tabular-nums;}\n.hk-band{border-top:1px solid rgba(8,8,7,.18);border-bottom:1px solid rgba(8,8,7,.18);}\n\n/* team */\n.tm-img{filter:grayscale(1) contrast(1.05);transition:filter .3s ease;}\n.tm:hover .tm-img{filter:grayscale(0) contrast(1);}\n</style>\n<div class=\"d antialiased\" data-kid=\"1\" style=\"background:var(--coal);color:var(--chalk);\">\n    <!-- ============ HEADER ============ -->\n    <header class=\"fixed top-0 left-0 right-0 z-50\" data-kid=\"1-1\" id=\"hdr\" style=\"background:transparent;\">\n        <div class=\"px-8 flex items-center justify-between\" data-kid=\"1-1-1\" style=\"height:64px;\">\n            <a class=\"text-[19px] font-semibold tracking-tight\" data-kid=\"1-1-1-1\" href=\"#\" style=\"color:var(--chalk);text-decoration:none;\">\n                hack47\n            </a>\n            <nav class=\"hidden lg:flex items-center gap-8 lbl\" data-kid=\"1-1-1-2\" style=\"color:rgba(242,239,232,.62);\">\n                <a data-kid=\"1-1-1-2-1\" href=\"#pilot\" style=\"text-decoration:none;color:inherit;\">\n                    pilot 01\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#mentors\" style=\"text-decoration:none;color:inherit;\">\n                    mentors\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#partners\" style=\"text-decoration:none;color:inherit;\">\n                    partners\n                </a>\n                <a data-kid=\"1-1-1-2-4\" href=\"#house\" style=\"text-decoration:none;color:inherit;\">\n                    the 30 days\n                </a>\n                <a data-kid=\"1-1-1-2-5\" href=\"#campus\" style=\"text-decoration:none;color:inherit;\">\n                    the campus\n                </a>\n                <a data-kid=\"1-1-1-2-6\" href=\"#hackathons\" style=\"text-decoration:none;color:inherit;\">\n                    hackathons\n                </a>\n            </nav>\n            <a class=\"btn-o lbl px-5 py-2.5\" data-kid=\"1-1-1-3\" href=\"#apply\" style=\"text-decoration:none;\">\n                apply\n                <span class=\"ar\" data-kid=\"1-1-1-3-1\">\n                    →\n                </span>\n            </a>\n        </div>\n        <div class=\"rule\" data-kid=\"1-1-2\" id=\"hdr-rule\" style=\"opacity:0;\">\n        </div>\n    </header>\n    <!-- ============ 1. HERO ============ -->\n    <section class=\"relative\" data-kid=\"1-2\" id=\"pilot\" style=\"height:86vh;min-height:660px;\">\n        <img alt=\"Villa facade at night with warm illuminated windows, photograph by Anahita on Unsplash\" class=\"absolute inset-0 w-full h-full object-cover ph\" data-kid=\"1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1562439427-b53f43a453bc?auto=format&w=2000&q=80&fit=crop\"/>\n        <div class=\"absolute inset-0\" data-kid=\"1-2-2\" style=\"background:linear-gradient(180deg,rgba(8,8,7,.74) 0%,rgba(8,8,7,.34) 34%,rgba(8,8,7,.86) 78%,var(--coal) 100%);\">\n        </div>\n        <div class=\"absolute hidden md:grid\" data-kid=\"1-2-3\" id=\"heroGrid\" style=\"right:64px;top:96px;grid-template-columns:repeat(4,26px);grid-auto-rows:56px;gap:8px;\">\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-1\">\n                <div class=\"glow\" data-kid=\"1-2-3-1-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-2\">\n                <div class=\"glow\" data-kid=\"1-2-3-2-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-3\">\n                <div class=\"glow\" data-kid=\"1-2-3-3-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-4\">\n                <div class=\"glow\" data-kid=\"1-2-3-4-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-5\">\n                <div class=\"glow\" data-kid=\"1-2-3-5-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-6\">\n                <div class=\"glow\" data-kid=\"1-2-3-6-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-7\">\n                <div class=\"glow\" data-kid=\"1-2-3-7-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-8\">\n                <div class=\"glow\" data-kid=\"1-2-3-8-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-9\">\n                <div class=\"glow\" data-kid=\"1-2-3-9-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-10\">\n                <div class=\"glow\" data-kid=\"1-2-3-10-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-11\">\n                <div class=\"glow\" data-kid=\"1-2-3-11-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-12\">\n                <div class=\"glow\" data-kid=\"1-2-3-12-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-13\">\n                <div class=\"glow\" data-kid=\"1-2-3-13-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-14\">\n                <div class=\"glow\" data-kid=\"1-2-3-14-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-15\">\n                <div class=\"glow\" data-kid=\"1-2-3-15-1\">\n                </div>\n            </div>\n            <div class=\"ap hero-ap\" data-kid=\"1-2-3-16\">\n                <div class=\"glow\" data-kid=\"1-2-3-16-1\">\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute hidden md:block lbl\" data-kid=\"1-2-4\" style=\"right:64px;top:70px;color:rgba(242,239,232,.5);\">\n            sixteen places\n        </div>\n        <div class=\"absolute left-0 right-0\" data-kid=\"1-2-5\" style=\"bottom:132px;\">\n            <div class=\"px-8\" data-kid=\"1-2-5-1\">\n                <div class=\"lbl mb-6\" data-kid=\"1-2-5-1-1\" style=\"color:var(--volt);\">\n                    pilot 01 · delhi villa · 30 days · 16 places\n                </div>\n                <h1 class=\"font-medium\" data-kid=\"1-2-5-1-2\" style=\"max-width:840px;font-size:clamp(40px,5.4vw,78px);line-height:.98;letter-spacing:-.03em;\">\n                    a house for builders who would rather ship than sleep.\n                </h1>\n            </div>\n        </div>\n        <div class=\"absolute left-0 right-0 bottom-0\" data-kid=\"1-2-6\" style=\"background:#0B0A09;border-top:1px solid var(--line);\">\n            <div class=\"px-8 flex flex-wrap items-stretch\" data-kid=\"1-2-6-1\" style=\"min-height:96px;\">\n                <div class=\"flex items-center gap-12 py-5 pr-12 flex-1\" data-kid=\"1-2-6-1-1\" style=\"min-width:280px;\">\n                    <div data-kid=\"1-2-6-1-1-1\">\n                        <div class=\"lbl mb-1.5\" data-kid=\"1-2-6-1-1-1-1\" style=\"color:rgba(242,239,232,.45);\">\n                            reached across india\n                        </div>\n                        <div class=\"tnum font-medium\" data-kid=\"1-2-6-1-1-1-2\" style=\"font-size:30px;letter-spacing:-.02em;\">\n                            40,000\n                            <span data-kid=\"1-2-6-1-1-1-2-1\" style=\"color:var(--volt);\">\n                                +\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-6-1-1-2\" style=\"width:1px;align-self:stretch;background:var(--line);\">\n                    </div>\n                    <div data-kid=\"1-2-6-1-1-3\">\n                        <div class=\"lbl mb-1.5\" data-kid=\"1-2-6-1-1-3-1\" style=\"color:rgba(242,239,232,.45);\">\n                            places\n                        </div>\n                        <div class=\"tnum font-medium\" data-kid=\"1-2-6-1-1-3-2\" style=\"font-size:30px;letter-spacing:-.02em;\">\n                            16\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-6-1-1-4\" style=\"width:1px;align-self:stretch;background:var(--line);\">\n                    </div>\n                    <div data-kid=\"1-2-6-1-1-5\">\n                        <div class=\"lbl mb-1.5\" data-kid=\"1-2-6-1-1-5-1\" style=\"color:rgba(242,239,232,.45);\">\n                            cohort\n                        </div>\n                        <div class=\"tnum font-medium\" data-kid=\"1-2-6-1-1-5-2\" style=\"font-size:30px;letter-spacing:-.02em;\">\n                            pilot 01\n                        </div>\n                    </div>\n                </div>\n                <a class=\"btn-o flex items-center px-8 lbl\" data-kid=\"1-2-6-1-2\" href=\"#apply\" style=\"text-decoration:none;\">\n                    apply for a place\n                    <span class=\"ar ml-2\" data-kid=\"1-2-6-1-2-1\">\n                        →\n                    </span>\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- ============ 2. SELECTION ============ -->\n    <section data-kid=\"1-3\" id=\"selection\" style=\"background:var(--volt);color:var(--chalk);\">\n        <div class=\"grid lg:grid-cols-[1.62fr_1fr]\" data-kid=\"1-3-1\">\n            <div class=\"px-8 py-20 lg:py-24 flex flex-col\" data-kid=\"1-3-1-1\" style=\"min-height:700px;\">\n                <div class=\"flex items-baseline justify-between gap-6\" data-kid=\"1-3-1-1-1\">\n                    <div class=\"lbl\" data-kid=\"1-3-1-1-1-1\" style=\"color:rgba(242,239,232,.7);\">\n                        01 — selection\n                    </div>\n                    <div class=\"lbl\" data-kid=\"1-3-1-1-1-2\" style=\"color:rgba(242,239,232,.55);\">\n                        live intake · funnel\n                    </div>\n                </div>\n                <!-- funnel: 40,000 applications streaming down into sixteen lights -->\n                <div class=\"relative flex-1 mt-10 mb-12\" data-kid=\"1-3-1-1-2\" style=\"min-height:400px;\">\n                    <canvas data-dynamic=\"true\" data-kid=\"1-3-1-1-2-1\" data-name=\"selection funnel canvas\" data-reason=\"particle funnel drawn by script\" id=\"selFunnel\">\n                    </canvas>\n                    <div class=\"lbl absolute\" data-kid=\"1-3-1-1-2-2\" style=\"left:0;top:-4px;color:rgba(242,239,232,.62);\">\n                        forty thousand builders\n                    </div>\n                    <div class=\"lbl absolute\" data-kid=\"1-3-1-1-2-3\" style=\"right:0;top:-4px;color:rgba(242,239,232,.42);\">\n                        india · 2026\n                    </div>\n                    <div class=\"lbl absolute\" data-kid=\"1-3-1-1-2-4\" style=\"left:0;bottom:-2px;color:rgba(242,239,232,.62);\">\n                        sixteen lights\n                    </div>\n                    <div class=\"lbl absolute\" data-kid=\"1-3-1-1-2-5\" style=\"right:0;bottom:-2px;color:rgba(242,239,232,.42);\">\n                        the gate closes once\n                    </div>\n                </div>\n                <div class=\"flex flex-wrap items-end gap-x-14 gap-y-6\" data-kid=\"1-3-1-1-3\">\n                    <div data-kid=\"1-3-1-1-3-1\">\n                        <div class=\"lbl mb-3\" data-kid=\"1-3-1-1-3-1-1\" style=\"color:rgba(242,239,232,.7);\">\n                            applications narrow to\n                        </div>\n                        <div class=\"tnum font-semibold\" data-kid=\"1-3-1-1-3-1-2\" id=\"bigSix\" style=\"font-size:clamp(72px,9.4vw,140px);line-height:.8;letter-spacing:-.05em;\">\n                            40,000\n                        </div>\n                    </div>\n                    <p data-kid=\"1-3-1-1-3-2\" style=\"max-width:330px;font-size:19px;line-height:1.4;letter-spacing:-.01em;color:rgba(242,239,232,.92);\">\n                        Sixteen places, and no way to widen the door. Proximity is the whole product.\n                    </p>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-2\" style=\"background:#0B0A09;color:var(--chalk);\">\n                <div class=\"px-8 py-9\" data-kid=\"1-3-1-2-1\" style=\"border-bottom:1px solid var(--line);\">\n                    <div class=\"lbl mb-3\" data-kid=\"1-3-1-2-1-1\" style=\"color:rgba(242,239,232,.45);\">\n                        builders reached across india\n                    </div>\n                    <div class=\"tnum font-medium text-right\" data-kid=\"1-3-1-2-1-2\" style=\"font-size:clamp(46px,5vw,68px);line-height:1;letter-spacing:-.03em;\">\n                        40,000+\n                    </div>\n                </div>\n                <div class=\"px-8 py-9\" data-kid=\"1-3-1-2-2\" style=\"border-bottom:1px solid var(--line);\">\n                    <div class=\"lbl mb-3\" data-kid=\"1-3-1-2-2-1\" style=\"color:rgba(242,239,232,.45);\">\n                        places in pilot 01\n                    </div>\n                    <div class=\"tnum font-medium text-right\" data-kid=\"1-3-1-2-2-2\" style=\"font-size:clamp(46px,5vw,68px);line-height:1;letter-spacing:-.03em;color:var(--volt);\">\n                        16\n                    </div>\n                </div>\n                <div class=\"px-8 py-9\" data-kid=\"1-3-1-2-3\" style=\"border-bottom:1px solid var(--line);\">\n                    <div class=\"lbl mb-3\" data-kid=\"1-3-1-2-3-1\" style=\"color:rgba(242,239,232,.45);\">\n                        days in the house\n                    </div>\n                    <div class=\"tnum font-medium text-right\" data-kid=\"1-3-1-2-3-2\" style=\"font-size:clamp(46px,5vw,68px);line-height:1;letter-spacing:-.03em;\">\n                        30\n                    </div>\n                </div>\n                <div class=\"px-8 py-9\" data-kid=\"1-3-1-2-4\">\n                    <p data-kid=\"1-3-1-2-4-1\" style=\"font-size:14px;line-height:1.6;color:rgba(242,239,232,.62);max-width:340px;\">\n                        Outreach reached more than forty thousand builders across India. Sixteen of them will live and work in the Delhi house.\n                    </p>\n                    <a class=\"ulink lbl inline-block mt-6\" data-kid=\"1-3-1-2-4-2\" href=\"#apply\" style=\"color:var(--volt);\">\n                        apply for one\n                        <span data-kid=\"1-3-1-2-4-2-1\">\n                            →\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ 3. PREMISE ============ -->\n    <section class=\"px-8 py-28 lg:py-36\" data-kid=\"1-4\" style=\"background:var(--coal);\">\n        <div class=\"lbl mb-16\" data-kid=\"1-4-1\" style=\"color:rgba(242,239,232,.42);\">\n            02 — the premise\n        </div>\n        <div class=\"grid lg:grid-cols-[auto_1fr] gap-14 lg:gap-24 items-start\" data-kid=\"1-4-2\">\n            <div class=\"grid shrink-0\" data-kid=\"1-4-2-1\" id=\"premGrid\" style=\"grid-template-columns:repeat(2,20px);grid-auto-rows:44px;gap:7px;\">\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-1\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-1-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-2\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-2-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-3\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-3-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-4\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-4-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-5\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-5-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-6\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-6-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-7\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-7-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-8\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-8-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-9\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-9-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-10\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-10-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-11\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-11-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-12\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-12-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-13\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-13-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-14\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-14-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-15\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-15-1\">\n                    </div>\n                </div>\n                <div class=\"ap hero-ap\" data-kid=\"1-4-2-1-16\">\n                    <div class=\"ap-fill\" data-kid=\"1-4-2-1-16-1\">\n                    </div>\n                </div>\n            </div>\n            <div data-kid=\"1-4-2-2\" style=\"max-width:720px;\">\n                <h2 class=\"font-medium mb-10 text-[34px] lg:text-[58px]\" data-kid=\"1-4-2-2-1\" data-name=\"premise section headline text\" style=\"line-height:1.02;letter-spacing:-.03em;\">\n                    a room changes the pace of the work.\n                </h2>\n                <p class=\"reveal\" data-kid=\"1-4-2-2-2\" style=\"font-size:19px;line-height:1.55;color:rgba(242,239,232,.76);\">\n                    The first Hack47 room is not a conference, a course, or a content calendar. It is thirty days in a Delhi villa with people who arrived to make the work more real. Build in the open. Ask better questions at dinner. Leave with something that exists.\n                </p>\n                <p class=\"reveal mt-7\" data-kid=\"1-4-2-2-3\" style=\"font-size:19px;line-height:1.55;color:rgba(242,239,232,.5);\">\n                    Not a lecture series. Not a demo-day factory. Pilot 01 stays small because proximity is the product.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ============ 4. MENTORS — slider ============ -->\n    <section class=\"py-28 lg:py-36\" data-kid=\"1-5\" id=\"mentors\" style=\"background:var(--chalk);color:#0B0A09;\">\n        <div class=\"px-8 flex flex-wrap items-end justify-between gap-8 mb-12\" data-kid=\"1-5-1\">\n            <h2 class=\"font-medium\" data-kid=\"1-5-1-1\" style=\"font-size:clamp(38px,5.2vw,76px);line-height:.95;letter-spacing:-.035em;max-width:640px;\">\n                the mentors coming into the house\n                <span data-kid=\"1-5-1-1-1\" style=\"color:var(--volt);\">\n                    .\n                </span>\n            </h2>\n            <div data-kid=\"1-5-1-2\" style=\"max-width:330px;\">\n                <div class=\"lbl mb-3\" data-kid=\"1-5-1-2-1\" style=\"color:rgba(8,8,7,.42);\">\n                    03 — who is in the room\n                </div>\n                <p data-kid=\"1-5-1-2-2\" style=\"font-size:14px;line-height:1.6;color:rgba(8,8,7,.66);\">\n                    Operators and researchers who come through the door during the thirty days. The roster grows as each one is confirmed.\n                </p>\n            </div>\n        </div>\n        <div class=\"px-8 flex items-center justify-between gap-8 mb-6\" data-kid=\"1-5-2\">\n            <div class=\"flex-1\" data-kid=\"1-5-2-1\" style=\"max-width:420px;height:2px;background:rgba(8,8,7,.14);\">\n                <div data-dynamic=\"true\" data-kid=\"1-5-2-1-1\" data-name=\"mentor progress bar\" data-reason=\"width updated by slider script\" id=\"mbar\" style=\"height:2px;width:22%;background:var(--volt);\">\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-5-2-2\">\n                <span class=\"lbl m tnum mr-2\" data-dynamic=\"true\" data-kid=\"1-5-2-2-1\" data-name=\"mentor count display\" data-reason=\"text updated by slider script\" id=\"mcount\" style=\"color:rgba(8,8,7,.45);\">\n                    01 / 05\n                </span>\n                <button aria-label=\"Previous mentor\" class=\"sbtn\" data-kid=\"1-5-2-2-2\" id=\"mprev\">\n                    <span class=\"ti ti-arrow-left\" data-kid=\"1-5-2-2-2-1\" style=\"font-size:17px;\">\n                    </span>\n                </button>\n                <button aria-label=\"Next mentor\" class=\"sbtn\" data-kid=\"1-5-2-2-3\" id=\"mnext\">\n                    <span class=\"ti ti-arrow-right\" data-kid=\"1-5-2-2-3-1\" style=\"font-size:17px;\">\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"flex gap-5 overflow-x-auto px-8 pb-4\" data-kid=\"1-5-3\" id=\"mtrack\">\n            <!-- 1 -->\n            <article class=\"mcard\" data-kid=\"1-5-3-1\">\n                <div class=\"overflow-hidden mb-5\" data-kid=\"1-5-3-1-1\" style=\"height:340px;background:rgba(8,8,7,.06);\">\n                    <img alt=\"Mentor portrait placeholder\" class=\"mcard-img w-full h-full object-cover\" data-kid=\"1-5-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/560?u=mentor-infra-h47\" style=\"filter:grayscale(1) contrast(1.06);\"/>\n                </div>\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-5-3-1-2\">\n                    <span class=\"lbl m tnum\" data-kid=\"1-5-3-1-2-1\" style=\"color:rgba(8,8,7,.35);\">\n                        01\n                    </span>\n                    <span class=\"lbl px-2 py-1\" data-kid=\"1-5-3-1-2-2\" style=\"background:var(--volt);color:var(--chalk);\">\n                        two weeks resident\n                    </span>\n                </div>\n                <h3 class=\"font-medium\" data-kid=\"1-5-3-1-3\" style=\"font-size:26px;letter-spacing:-.02em;\">\n                    [mentor name]\n                </h3>\n                <div class=\"lbl mt-1.5 mb-4\" data-kid=\"1-5-3-1-4\" style=\"color:rgba(8,8,7,.5);\">\n                    staff engineer · infrastructure\n                </div>\n                <div class=\"rule-dk mb-4\" data-kid=\"1-5-3-1-5\">\n                </div>\n                <div class=\"lbl mb-2\" data-kid=\"1-5-3-1-6\" style=\"color:rgba(8,8,7,.42);\">\n                    come to them for\n                </div>\n                <p data-kid=\"1-5-3-1-7\" style=\"font-size:15px;line-height:1.5;color:rgba(8,8,7,.78);\">\n                    Taking a prototype that works on one machine and making it survive real traffic — queues, storage, cost per request, and what to leave out.\n                </p>\n            </article>\n            <!-- 2 -->\n            <article class=\"mcard\" data-kid=\"1-5-3-2\">\n                <div class=\"overflow-hidden mb-5\" data-kid=\"1-5-3-2-1\" style=\"height:340px;background:rgba(8,8,7,.06);\">\n                    <img alt=\"Mentor portrait placeholder\" class=\"mcard-img w-full h-full object-cover\" data-kid=\"1-5-3-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/560?u=mentor-research-h47\" style=\"filter:grayscale(1) contrast(1.06);\"/>\n                </div>\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-5-3-2-2\">\n                    <span class=\"lbl m tnum\" data-kid=\"1-5-3-2-2-1\" style=\"color:rgba(8,8,7,.35);\">\n                        02\n                    </span>\n                    <span class=\"lbl px-2 py-1\" data-kid=\"1-5-3-2-2-2\" style=\"background:var(--volt);color:var(--chalk);\">\n                        weekly office hours\n                    </span>\n                </div>\n                <h3 class=\"font-medium\" data-kid=\"1-5-3-2-3\" style=\"font-size:26px;letter-spacing:-.02em;\">\n                    [mentor name]\n                </h3>\n                <div class=\"lbl mt-1.5 mb-4\" data-kid=\"1-5-3-2-4\" style=\"color:rgba(8,8,7,.5);\">\n                    research scientist\n                </div>\n                <div class=\"rule-dk mb-4\" data-kid=\"1-5-3-2-5\">\n                </div>\n                <div class=\"lbl mb-2\" data-kid=\"1-5-3-2-6\" style=\"color:rgba(8,8,7,.42);\">\n                    come to them for\n                </div>\n                <p data-kid=\"1-5-3-2-7\" style=\"font-size:15px;line-height:1.5;color:rgba(8,8,7,.78);\">\n                    Reading a paper properly, designing an evaluation you can trust, and knowing when a result is real rather than a lucky seed.\n                </p>\n            </article>\n            <!-- 3 -->\n            <article class=\"mcard\" data-kid=\"1-5-3-3\">\n                <div class=\"overflow-hidden mb-5\" data-kid=\"1-5-3-3-1\" style=\"height:340px;background:rgba(8,8,7,.06);\">\n                    <img alt=\"Mentor portrait placeholder\" class=\"mcard-img w-full h-full object-cover\" data-kid=\"1-5-3-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/560?u=mentor-gtm-h47\" style=\"filter:grayscale(1) contrast(1.06);\"/>\n                </div>\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-5-3-3-2\">\n                    <span class=\"lbl m tnum\" data-kid=\"1-5-3-3-2-1\" style=\"color:rgba(8,8,7,.35);\">\n                        03\n                    </span>\n                    <span class=\"lbl px-2 py-1\" data-kid=\"1-5-3-3-2-2\" style=\"background:var(--volt);color:var(--chalk);\">\n                        one long dinner\n                    </span>\n                </div>\n                <h3 class=\"font-medium\" data-kid=\"1-5-3-3-3\" style=\"font-size:26px;letter-spacing:-.02em;\">\n                    [mentor name]\n                </h3>\n                <div class=\"lbl mt-1.5 mb-4\" data-kid=\"1-5-3-3-4\" style=\"color:rgba(8,8,7,.5);\">\n                    founder\n                </div>\n                <div class=\"rule-dk mb-4\" data-kid=\"1-5-3-3-5\">\n                </div>\n                <div class=\"lbl mb-2\" data-kid=\"1-5-3-3-6\" style=\"color:rgba(8,8,7,.42);\">\n                    come to them for\n                </div>\n                <p data-kid=\"1-5-3-3-7\" style=\"font-size:15px;line-height:1.5;color:rgba(8,8,7,.78);\">\n                    Finding the first ten people who actually want the thing, and the difference between interest and use.\n                </p>\n            </article>\n            <!-- 4 -->\n            <article class=\"mcard\" data-kid=\"1-5-3-4\">\n                <div class=\"overflow-hidden mb-5\" data-kid=\"1-5-3-4-1\" style=\"height:340px;background:rgba(8,8,7,.06);\">\n                    <img alt=\"Mentor portrait placeholder\" class=\"mcard-img w-full h-full object-cover\" data-kid=\"1-5-3-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/560?u=mentor-design-h47\" style=\"filter:grayscale(1) contrast(1.06);\"/>\n                </div>\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-5-3-4-2\">\n                    <span class=\"lbl m tnum\" data-kid=\"1-5-3-4-2-1\" style=\"color:rgba(8,8,7,.35);\">\n                        04\n                    </span>\n                    <span class=\"lbl px-2 py-1\" data-kid=\"1-5-3-4-2-2\" style=\"border:1px solid rgba(8,8,7,.24);color:rgba(8,8,7,.5);\">\n                        being confirmed\n                    </span>\n                </div>\n                <h3 class=\"font-medium\" data-kid=\"1-5-3-4-3\" style=\"font-size:26px;letter-spacing:-.02em;\">\n                    [mentor name]\n                </h3>\n                <div class=\"lbl mt-1.5 mb-4\" data-kid=\"1-5-3-4-4\" style=\"color:rgba(8,8,7,.5);\">\n                    product designer\n                </div>\n                <div class=\"rule-dk mb-4\" data-kid=\"1-5-3-4-5\">\n                </div>\n                <div class=\"lbl mb-2\" data-kid=\"1-5-3-4-6\" style=\"color:rgba(8,8,7,.42);\">\n                    come to them for\n                </div>\n                <p data-kid=\"1-5-3-4-7\" style=\"font-size:15px;line-height:1.5;color:rgba(8,8,7,.78);\">\n                    Making a rough tool legible to somebody who did not build it — naming, hierarchy, and cutting the second screen.\n                </p>\n            </article>\n            <!-- 5 open slot -->\n            <article class=\"mcard\" data-kid=\"1-5-3-5\">\n                <div class=\"mb-5 flex items-center justify-center\" data-kid=\"1-5-3-5-1\" style=\"height:340px;border:1px dashed rgba(8,8,7,.28);\">\n                    <span class=\"lbl\" data-kid=\"1-5-3-5-1-1\" style=\"color:rgba(8,8,7,.35);\">\n                        slot open\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-5-3-5-2\">\n                    <span class=\"lbl m tnum\" data-kid=\"1-5-3-5-2-1\" style=\"color:rgba(8,8,7,.35);\">\n                        05\n                    </span>\n                </div>\n                <h3 class=\"font-medium\" data-kid=\"1-5-3-5-3\" style=\"font-size:26px;letter-spacing:-.02em;color:rgba(8,8,7,.45);\">\n                    to be announced\n                </h3>\n                <div class=\"lbl mt-1.5 mb-4\" data-kid=\"1-5-3-5-4\" style=\"color:rgba(8,8,7,.4);\">\n                    open seat\n                </div>\n                <div class=\"rule-dk mb-4\" data-kid=\"1-5-3-5-5\">\n                </div>\n                <p data-kid=\"1-5-3-5-6\" style=\"font-size:15px;line-height:1.5;color:rgba(8,8,7,.6);\">\n                    One seat is deliberately unfilled until the cohort is picked, so it can be matched to what the sixteen are actually building.\n                </p>\n                <a class=\"ulink lbl inline-block mt-5\" data-kid=\"1-5-3-5-7\" href=\"#\" style=\"color:var(--volt);\">\n                    suggest a mentor\n                    <span data-kid=\"1-5-3-5-7-1\">\n                        ↗\n                    </span>\n                </a>\n            </article>\n            <div class=\"shrink-0\" data-kid=\"1-5-3-6\" style=\"width:8px;\">\n            </div>\n        </div>\n        <div class=\"px-8 mt-10\" data-kid=\"1-5-4\">\n            <p class=\"m\" data-kid=\"1-5-4-1\" style=\"font-size:13px;color:rgba(8,8,7,.55);\">\n                Further mentors are announced here as they are confirmed.\n            </p>\n        </div>\n    </section>\n    <!-- ============ 5. PARTNERS — logo wall ============ -->\n    <section class=\"px-8 py-28 lg:py-32\" data-kid=\"1-6\" id=\"partners\" style=\"background:var(--coal);\">\n        <div class=\"flex flex-wrap items-end justify-between gap-8 mb-4\" data-kid=\"1-6-1\">\n            <h2 class=\"font-medium\" data-kid=\"1-6-1-1\" style=\"font-size:clamp(32px,4.2vw,58px);line-height:.98;letter-spacing:-.03em;max-width:680px;\">\n                working with the people building it\n                <span data-kid=\"1-6-1-1-1\" style=\"color:var(--volt);\">\n                    .\n                </span>\n            </h2>\n            <div class=\"lbl\" data-kid=\"1-6-1-2\" style=\"color:rgba(242,239,232,.42);\">\n                04 — partners & support\n            </div>\n        </div>\n        <p class=\"mb-14\" data-kid=\"1-6-2\" style=\"font-size:15px;line-height:1.6;color:rgba(242,239,232,.5);max-width:560px;\">\n            Credits, compute, tooling and first-cheque conversations for the sixteen. The stack the house runs on.\n        </p>\n        <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-8 gap-y-6 gap-x-4\" data-kid=\"1-6-3\" id=\"logoWall\">\n            <div class=\"logo-cell\" data-kid=\"1-6-3-1\">\n                <img alt=\"OpenAI\" data-kid=\"1-6-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/openai.svg\"/>\n                <span data-kid=\"1-6-3-1-2\">\n                    OpenAI\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-2\">\n                <img alt=\"Anthropic\" data-kid=\"1-6-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/anthropic.svg\"/>\n                <span data-kid=\"1-6-3-2-2\">\n                    Anthropic\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-3\">\n                <img alt=\"Google Gemini\" data-kid=\"1-6-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/googlegemini.svg\"/>\n                <span data-kid=\"1-6-3-3-2\">\n                    Gemini\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-4\">\n                <img alt=\"Meta\" data-kid=\"1-6-3-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/meta.svg\"/>\n                <span data-kid=\"1-6-3-4-2\">\n                    Meta AI\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-5\">\n                <img alt=\"Hugging Face\" data-kid=\"1-6-3-5-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/huggingface.svg\"/>\n                <span data-kid=\"1-6-3-5-2\">\n                    Hugging Face\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-6\">\n                <img alt=\"Perplexity\" data-kid=\"1-6-3-6-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/perplexity.svg\"/>\n                <span data-kid=\"1-6-3-6-2\">\n                    Perplexity\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-7\">\n                <img alt=\"NVIDIA\" data-kid=\"1-6-3-7-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/nvidia.svg\"/>\n                <span data-kid=\"1-6-3-7-2\">\n                    NVIDIA\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-8\">\n                <img alt=\"Ollama\" data-kid=\"1-6-3-8-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/ollama.svg\"/>\n                <span data-kid=\"1-6-3-8-2\">\n                    Ollama\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-9\">\n                <img alt=\"Modal\" data-kid=\"1-6-3-9-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/modal.svg\"/>\n                <span data-kid=\"1-6-3-9-2\">\n                    Modal\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-10\">\n                <img alt=\"Ray\" data-kid=\"1-6-3-10-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/ray.svg\"/>\n                <span data-kid=\"1-6-3-10-2\">\n                    Ray\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-11\">\n                <img alt=\"PyTorch\" data-kid=\"1-6-3-11-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/pytorch.svg\"/>\n                <span data-kid=\"1-6-3-11-2\">\n                    PyTorch\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-12\">\n                <img alt=\"LangChain\" data-kid=\"1-6-3-12-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/langchain.svg\"/>\n                <span data-kid=\"1-6-3-12-2\">\n                    LangChain\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-13\">\n                <img alt=\"Docker\" data-kid=\"1-6-3-13-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/docker.svg\"/>\n                <span data-kid=\"1-6-3-13-2\">\n                    Docker\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-14\">\n                <img alt=\"Kubernetes\" data-kid=\"1-6-3-14-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/kubernetes.svg\"/>\n                <span data-kid=\"1-6-3-14-2\">\n                    Kubernetes\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-15\">\n                <img alt=\"Cloudflare\" data-kid=\"1-6-3-15-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/cloudflare.svg\"/>\n                <span data-kid=\"1-6-3-15-2\">\n                    Cloudflare\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-16\">\n                <img alt=\"PostgreSQL\" data-kid=\"1-6-3-16-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/postgresql.svg\"/>\n                <span data-kid=\"1-6-3-16-2\">\n                    Postgres\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-17\">\n                <img alt=\"Vercel\" data-kid=\"1-6-3-17-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/vercel.svg\"/>\n                <span data-kid=\"1-6-3-17-2\">\n                    Vercel\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-18\">\n                <img alt=\"Supabase\" data-kid=\"1-6-3-18-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/supabase.svg\"/>\n                <span data-kid=\"1-6-3-18-2\">\n                    Supabase\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-19\">\n                <img alt=\"MongoDB\" data-kid=\"1-6-3-19-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/mongodb.svg\"/>\n                <span data-kid=\"1-6-3-19-2\">\n                    MongoDB\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-20\">\n                <img alt=\"GitHub\" data-kid=\"1-6-3-20-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/github.svg\"/>\n                <span data-kid=\"1-6-3-20-2\">\n                    GitHub\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-21\">\n                <img alt=\"Linear\" data-kid=\"1-6-3-21-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/linear.svg\"/>\n                <span data-kid=\"1-6-3-21-2\">\n                    Linear\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-22\">\n                <img alt=\"Figma\" data-kid=\"1-6-3-22-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/figma.svg\"/>\n                <span data-kid=\"1-6-3-22-2\">\n                    Figma\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-23\">\n                <img alt=\"Stripe\" data-kid=\"1-6-3-23-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/stripe.svg\"/>\n                <span data-kid=\"1-6-3-23-2\">\n                    Stripe\n                </span>\n            </div>\n            <div class=\"logo-cell\" data-kid=\"1-6-3-24\">\n                <img alt=\"Replit\" data-kid=\"1-6-3-24-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logos/replit.svg\"/>\n                <span data-kid=\"1-6-3-24-2\">\n                    Replit\n                </span>\n            </div>\n        </div>\n        <div class=\"rule mt-16 mb-16\" data-kid=\"1-6-4\">\n        </div>\n        <div class=\"grid lg:grid-cols-[1fr_auto] gap-10 items-start\" data-kid=\"1-6-5\">\n            <div data-kid=\"1-6-5-1\">\n                <h3 class=\"font-medium mb-5\" data-kid=\"1-6-5-1-1\" style=\"font-size:clamp(26px,2.6vw,36px);letter-spacing:-.025em;\">\n                    Looking to partner?\n                </h3>\n                <p data-kid=\"1-6-5-1-2\" style=\"font-size:18px;line-height:1.55;color:rgba(242,239,232,.72);max-width:760px;\">\n                    Hack47 puts sixteen of India’s sharpest builders in one Delhi house for thirty days. Partners show up as credits, compute, tooling, teaching time, or a first cheque — and get a month inside the work rather than a logo on a banner.\n                </p>\n                <div class=\"flex flex-wrap gap-x-8 gap-y-3 mt-7 lbl\" data-kid=\"1-6-5-1-3\" style=\"color:rgba(242,239,232,.45);\">\n                    <span data-kid=\"1-6-5-1-3-1\">\n                        credits\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-2\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-3\">\n                        compute\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-4\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-5\">\n                        tooling\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-6\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-7\">\n                        teaching time\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-8\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-6-5-1-3-9\">\n                        capital\n                    </span>\n                </div>\n                <a class=\"pill inline-flex items-center gap-2 px-7 py-4 lbl mt-9\" data-kid=\"1-6-5-1-4\" href=\"#\" style=\"text-decoration:none;\">\n                    partner with us\n                    <span class=\"ti ti-arrow-up-right\" data-kid=\"1-6-5-1-4-1\" style=\"font-size:13px;\">\n                    </span>\n                </a>\n            </div>\n            <p class=\"m\" data-kid=\"1-6-5-2\" style=\"font-size:12px;line-height:1.7;color:rgba(242,239,232,.32);max-width:250px;\">\n                Marks shown are the tools the house builds on. Formal partnerships are listed by name once each one clears it.\n            </p>\n        </div>\n    </section>\n    <!-- ============ 6. THE THIRTY DAYS ============ -->\n    <section data-kid=\"1-7\" id=\"house\" style=\"background:var(--volt);color:var(--chalk);\">\n        <div class=\"px-8 pt-20 pb-10 flex flex-wrap items-end justify-between gap-6\" data-kid=\"1-7-1\">\n            <h2 class=\"font-medium\" data-kid=\"1-7-1-1\" style=\"font-size:clamp(34px,4.4vw,62px);line-height:.98;letter-spacing:-.03em;max-width:640px;\">\n                thirty days, and how they are spent.\n            </h2>\n            <div class=\"lbl\" data-kid=\"1-7-1-2\" style=\"color:rgba(242,239,232,.72);\">\n                05 — the operating rhythm\n            </div>\n        </div>\n        <!-- 30 day ticks -->\n        <div class=\"px-8 pb-3\" data-kid=\"1-7-2\">\n            <div class=\"flex items-end gap-[3px]\" data-dynamic=\"true\" data-kid=\"1-7-2-1\" data-name=\"day ticks container\" data-reason=\"ticks generated by script\" id=\"dayTicks\" style=\"height:34px;\">\n            </div>\n            <div class=\"flex justify-between lbl mt-3\" data-kid=\"1-7-2-2\" style=\"color:rgba(242,239,232,.6);\">\n                <span data-kid=\"1-7-2-2-1\">\n                    day 01 · arrival\n                </span>\n                <span class=\"hidden sm:block\" data-kid=\"1-7-2-2-2\">\n                    day 15 · the cut\n                </span>\n                <span data-kid=\"1-7-2-2-3\">\n                    day 30 · ship\n                </span>\n            </div>\n        </div>\n        <div data-kid=\"1-7-3\" style=\"border-top:1px solid rgba(242,239,232,.3);\">\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-1\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-1-1\" style=\"color:rgba(242,239,232,.68);\">\n                    day 00\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-1-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    you arrive mid‑build\n                </div>\n                <p data-kid=\"1-7-3-1-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    Nobody starts from a blank page. You come in with something already running — a repo, a prototype, a user or two — and the thirty days are spent pushing it somewhere it could not have gone alone.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-2\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-2-1\" style=\"color:rgba(242,239,232,.68);\">\n                    daily\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-2-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    build in the open\n                </div>\n                <p data-kid=\"1-7-3-2-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    One log entry a day, posted where the other fifteen can read it. What moved, what broke, what you are stuck on. Being stuck in public is how you stop being stuck.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-3\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-3-1\" style=\"color:rgba(242,239,232,.68);\">\n                    every friday\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-3-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    demo, not slides\n                </div>\n                <p data-kid=\"1-7-3-3-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    Four demo nights across the month. Ten minutes each, live software only. If it cannot be shown running, it does not get shown.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-4\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-4-1\" style=\"color:rgba(242,239,232,.68);\">\n                    nightly, 9pm\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-4-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    the table is the seminar\n                </div>\n                <p data-kid=\"1-7-3-4-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    One long table, everyone at it. Whoever is closest to a hard problem talks first, and the rest of the room takes it apart. Most of what people remember happens here.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-5\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-5-1\" style=\"color:rgba(242,239,232,.68);\">\n                    day 15\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-5-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    the honest cut\n                </div>\n                <p data-kid=\"1-7-3-5-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    Halfway, every project gets a hard review from mentors and the room. Double down, cut scope, or start again with two weeks left. People who change direction here usually finish stronger.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-6\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-6-1\" style=\"color:rgba(242,239,232,.68);\">\n                    all month\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-6-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    no friction budget\n                </div>\n                <p data-kid=\"1-7-3-6-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    Room, food, laundry, desk, bandwidth and machines are handled by the house. Not a perk — a design decision. The only difficult thing in your day should be the work.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-7\" style=\"border-bottom:1px solid rgba(242,239,232,.22);\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-7-1\" style=\"color:rgba(242,239,232,.68);\">\n                    day 30\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-7-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    ship day\n                </div>\n                <p data-kid=\"1-7-3-7-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    One open evening in Delhi. Mentors, partners and whoever the sixteen want in the room. Everything shown is running, and everything shown is yours — Hack47 takes no equity.\n                </p>\n            </div>\n            <div class=\"clock-row px-8 py-8 grid lg:grid-cols-[132px_248px_1fr] gap-3 lg:gap-10 items-baseline\" data-kid=\"1-7-3-8\">\n                <div class=\"lbl m tnum\" data-kid=\"1-7-3-8-1\" style=\"color:rgba(242,239,232,.68);\">\n                    after\n                </div>\n                <div class=\"clock-key m font-medium\" data-kid=\"1-7-3-8-2\" style=\"font-size:clamp(21px,2.2vw,29px);letter-spacing:-.02em;color:rgba(242,239,232,.9);\">\n                    you keep the room\n                </div>\n                <p data-kid=\"1-7-3-8-3\" style=\"font-size:17px;line-height:1.5;max-width:680px;color:rgba(242,239,232,.88);\">\n                    The thirty days end, the fifteen other people do not. Alumni of pilot 01 keep house access, intros, and first call on every room that opens after this one.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ============ 7. GALLERY ============ -->\n    <section class=\"py-24 lg:py-32\" data-kid=\"1-8\" style=\"background:var(--coal);\">\n        <div class=\"px-8 flex flex-wrap items-end justify-between gap-6 mb-12\" data-kid=\"1-8-1\">\n            <h2 class=\"font-medium\" data-kid=\"1-8-1-1\" style=\"font-size:clamp(30px,3.4vw,48px);letter-spacing:-.03em;\">\n                the villa\n                <span data-kid=\"1-8-1-1-1\" style=\"color:var(--volt);\">\n                    .\n                </span>\n            </h2>\n            <div class=\"m lbl\" data-kid=\"1-8-1-2\" style=\"color:rgba(242,239,232,.42);\">\n                01\n                <span data-kid=\"1-8-1-2-1\" style=\"color:rgba(242,239,232,.24);\">\n                    —\n                </span>\n                04 · delhi\n            </div>\n        </div>\n        <div class=\"flex gap-4 px-8 overflow-x-auto pb-2\" data-kid=\"1-8-2\">\n            <figure class=\"shrink-0\" data-kid=\"1-8-2-1\" style=\"width:min(720px,74vw);\">\n                <div class=\"overflow-hidden\" data-kid=\"1-8-2-1-1\" style=\"height:430px;\">\n                    <img alt=\"Long shared wooden dining table in a villa, photograph by Maria Orlova on Pexels\" class=\"gal-img w-full h-full object-cover ph\" data-kid=\"1-8-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4913346/pexels-photo-4913346.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3\" data-kid=\"1-8-2-1-2\" style=\"color:rgba(242,239,232,.5);\">\n                    01 / the work table\n                </figcaption>\n            </figure>\n            <figure class=\"shrink-0\" data-kid=\"1-8-2-2\" style=\"width:min(330px,56vw);\">\n                <div class=\"overflow-hidden\" data-kid=\"1-8-2-2-1\" style=\"height:430px;\">\n                    <img alt=\"Atmospheric courtyard with dense planting, photograph by Vero Lova on Pexels\" class=\"gal-img w-full h-full object-cover ph\" data-kid=\"1-8-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/36578943/pexels-photo-36578943.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3\" data-kid=\"1-8-2-2-2\" style=\"color:rgba(242,239,232,.5);\">\n                    02 / the courtyard\n                </figcaption>\n            </figure>\n            <figure class=\"shrink-0\" data-kid=\"1-8-2-3\" style=\"width:min(330px,56vw);\">\n                <div class=\"overflow-hidden\" data-kid=\"1-8-2-3-1\" style=\"height:430px;\">\n                    <img alt=\"Workspace with laptops under warm task lighting, photograph by Hilmi Isilak on Pexels\" class=\"gal-img w-full h-full object-cover ph\" data-kid=\"1-8-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/28399223/pexels-photo-28399223.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3\" data-kid=\"1-8-2-3-2\" style=\"color:rgba(242,239,232,.5);\">\n                    03 / late light\n                </figcaption>\n            </figure>\n            <figure class=\"shrink-0\" data-kid=\"1-8-2-4\" style=\"width:min(330px,56vw);\">\n                <div class=\"overflow-hidden\" data-kid=\"1-8-2-4-1\" style=\"height:430px;\">\n                    <img alt=\"Illuminated street at night, photograph by Bryan Dijkhuizen on Pexels\" class=\"gal-img w-full h-full object-cover ph\" data-kid=\"1-8-2-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/20219148/pexels-photo-20219148.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3\" data-kid=\"1-8-2-4-2\" style=\"color:rgba(242,239,232,.5);\">\n                    04 / the street outside\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <!-- ============ 8. THE CAMPUS ============ -->\n    <section class=\"px-8 py-28 lg:py-36\" data-kid=\"1-9\" id=\"campus\" style=\"background:var(--soot);\">\n        <div class=\"flex flex-wrap items-end justify-between gap-6 mb-16\" data-kid=\"1-9-1\">\n            <h2 class=\"font-medium\" data-kid=\"1-9-1-1\" style=\"font-size:clamp(32px,4.2vw,60px);line-height:1;letter-spacing:-.03em;max-width:700px;\">\n                the house is a rehearsal for a campus.\n            </h2>\n            <div class=\"lbl\" data-kid=\"1-9-1-2\" style=\"color:rgba(242,239,232,.42);\">\n                06 — what comes after\n            </div>\n        </div>\n        <div class=\"grid lg:grid-cols-[1.25fr_1fr] gap-12 lg:gap-16 items-start\" data-kid=\"1-9-2\">\n            <!-- sketch placeholder -->\n            <figure class=\"m-0\" data-kid=\"1-9-2-1\">\n                <div class=\"relative flex items-center justify-center\" data-kid=\"1-9-2-1-1\" id=\"sketchFrame\" style=\"aspect-ratio:16/10;border:1px dashed rgba(242,239,232,.34);background:rgba(242,239,232,.03);\">\n                    <div class=\"absolute\" data-kid=\"1-9-2-1-1-1\" style=\"left:14px;top:14px;width:22px;height:22px;border-left:1px solid var(--volt);border-top:1px solid var(--volt);\">\n                    </div>\n                    <div class=\"absolute\" data-kid=\"1-9-2-1-1-2\" style=\"right:14px;top:14px;width:22px;height:22px;border-right:1px solid var(--volt);border-top:1px solid var(--volt);\">\n                    </div>\n                    <div class=\"absolute\" data-kid=\"1-9-2-1-1-3\" style=\"left:14px;bottom:14px;width:22px;height:22px;border-left:1px solid var(--volt);border-bottom:1px solid var(--volt);\">\n                    </div>\n                    <div class=\"absolute\" data-kid=\"1-9-2-1-1-4\" style=\"right:14px;bottom:14px;width:22px;height:22px;border-right:1px solid var(--volt);border-bottom:1px solid var(--volt);\">\n                    </div>\n                    <div class=\"text-center px-8\" data-kid=\"1-9-2-1-1-5\">\n                        <span class=\"ti ti-pencil-minus block mb-4\" data-kid=\"1-9-2-1-1-5-1\" style=\"font-size:30px;color:rgba(242,239,232,.34);\">\n                        </span>\n                        <div class=\"lbl mb-2\" data-kid=\"1-9-2-1-1-5-2\" style=\"color:rgba(242,239,232,.6);\">\n                            sketch — the campus\n                        </div>\n                        <p class=\"m\" data-kid=\"1-9-2-1-1-5-3\" style=\"font-size:12px;line-height:1.7;color:rgba(242,239,232,.34);max-width:280px;margin:0 auto;\">\n                            drawing goes here / 16:10 / delhi site plan\n                        </p>\n                    </div>\n                </div>\n                <figcaption class=\"flex flex-wrap justify-between gap-4 lbl mt-4\" data-kid=\"1-9-2-1-2\" style=\"color:rgba(242,239,232,.42);\">\n                    <span data-kid=\"1-9-2-1-2-1\">\n                        fig. 01 — founder campus, delhi\n                    </span>\n                    <span data-kid=\"1-9-2-1-2-2\">\n                        concept · not yet built\n                    </span>\n                </figcaption>\n            </figure>\n            <div data-kid=\"1-9-2-2\">\n                <p data-kid=\"1-9-2-2-1\" style=\"font-size:19px;line-height:1.55;color:rgba(242,239,232,.82);\">\n                    Pilot 01 is thirty days in a rented villa. What we are actually building is permanent: a founder campus in Delhi where people live on site, cohorts overlap, and the door does not close at the end of a month.\n                </p>\n                <p class=\"mt-6\" data-kid=\"1-9-2-2-2\" style=\"font-size:17px;line-height:1.6;color:rgba(242,239,232,.55);\">\n                    One address. Residencies running back to back, a workshop and a studio floor, mentors who keep desks there, and a community that compounds because nobody has to leave to stay in it. India has plenty of programmes and almost no places. We are building the place.\n                </p>\n                <div class=\"mt-12 relative\" data-kid=\"1-9-2-2-3\" style=\"padding-top:30px;\">\n                    <div class=\"absolute\" data-kid=\"1-9-2-2-3-1\" style=\"left:0;right:0;top:44px;height:1px;background:var(--line);\">\n                    </div>\n                    <div class=\"absolute\" data-dynamic=\"true\" data-kid=\"1-9-2-2-3-2\" data-name=\"campus progression line\" data-reason=\"width updated by scroll trigger\" id=\"netLine\" style=\"left:0;top:44px;height:1px;background:var(--volt);width:0;\">\n                    </div>\n                    <div class=\"grid grid-cols-3 gap-6\" data-kid=\"1-9-2-2-3-3\">\n                        <div data-kid=\"1-9-2-2-3-3-1\">\n                            <div data-kid=\"1-9-2-2-3-3-1-1\" style=\"width:13px;height:13px;background:var(--volt);margin-bottom:20px;\">\n                            </div>\n                            <div class=\"font-medium\" data-kid=\"1-9-2-2-3-3-1-2\" style=\"font-size:19px;letter-spacing:-.02em;\">\n                                the house\n                            </div>\n                            <div class=\"lbl mt-2\" data-kid=\"1-9-2-2-3-3-1-3\" style=\"color:var(--volt);\">\n                                now · pilot 01\n                            </div>\n                            <p class=\"mt-3\" data-kid=\"1-9-2-2-3-3-1-4\" style=\"font-size:13px;line-height:1.55;color:rgba(242,239,232,.5);\">\n                                One villa, sixteen places, thirty days.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-9-2-2-3-3-2\">\n                            <div data-kid=\"1-9-2-2-3-3-2-1\" style=\"width:13px;height:13px;border:1px solid rgba(242,239,232,.6);margin-bottom:20px;\">\n                            </div>\n                            <div class=\"font-medium\" data-kid=\"1-9-2-2-3-3-2-2\" style=\"font-size:19px;letter-spacing:-.02em;\">\n                                back-to-back rooms\n                            </div>\n                            <div class=\"lbl mt-2\" data-kid=\"1-9-2-2-3-3-2-3\" style=\"color:rgba(242,239,232,.45);\">\n                                next\n                            </div>\n                            <p class=\"mt-3\" data-kid=\"1-9-2-2-3-3-2-4\" style=\"font-size:13px;line-height:1.55;color:rgba(242,239,232,.42);\">\n                                Cohorts that overlap, so the room never fully empties.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-9-2-2-3-3-3\">\n                            <div data-kid=\"1-9-2-2-3-3-3-1\" style=\"width:13px;height:13px;border:1px solid rgba(242,239,232,.28);margin-bottom:20px;\">\n                            </div>\n                            <div class=\"font-medium\" data-kid=\"1-9-2-2-3-3-3-2\" style=\"font-size:19px;letter-spacing:-.02em;color:rgba(242,239,232,.5);\">\n                                the campus\n                            </div>\n                            <div class=\"lbl mt-2\" data-kid=\"1-9-2-2-3-3-3-3\" style=\"color:rgba(242,239,232,.3);\">\n                                being designed\n                            </div>\n                            <p class=\"mt-3\" data-kid=\"1-9-2-2-3-3-3-4\" style=\"font-size:13px;line-height:1.55;color:rgba(242,239,232,.34);\">\n                                A permanent Delhi address built for founders who live on site.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <a class=\"ulink lbl inline-block mt-12\" data-kid=\"1-9-2-2-4\" href=\"#\" style=\"color:var(--volt);\">\n                    help us build the campus\n                    <span class=\"ti ti-arrow-up-right\" data-kid=\"1-9-2-2-4-1\" style=\"font-size:12px;\">\n                    </span>\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- ============ 8b. HACKATHONS ============ -->\n    <section class=\"px-8 py-28 lg:py-36\" data-kid=\"1-95\" id=\"hackathons\" style=\"background:var(--chalk);color:#0B0A09;\">\n        <div class=\"flex flex-wrap items-end justify-between gap-8 mb-12\" data-kid=\"1-95-1\">\n            <div data-kid=\"1-95-1-1\">\n                <div class=\"lbl mb-6\" data-kid=\"1-95-1-1-1\" style=\"color:rgba(8,8,7,.42);\">\n                    07 — hackathons\n                </div>\n                <h2 class=\"font-medium\" data-kid=\"1-95-1-1-2\" style=\"font-size:clamp(38px,5.2vw,76px);line-height:.95;letter-spacing:-.035em;max-width:720px;\">\n                    forty-seven hours, in one city at a time\n                    <span data-kid=\"1-95-1-1-2-1\" style=\"color:var(--volt);\">\n                        .\n                    </span>\n                </h2>\n            </div>\n            <p data-kid=\"1-95-1-2\" style=\"max-width:340px;font-size:14px;line-height:1.6;color:rgba(8,8,7,.66);\">\n                The house takes sixteen. The hackathons are how we meet everybody else — short, in person, and run in the cities builders already live in.\n            </p>\n        </div>\n        <p class=\"mb-14\" data-kid=\"1-95-2\" style=\"max-width:820px;font-size:19px;line-height:1.55;color:rgba(8,8,7,.8);\">\n            Hack47 runs a rolling series of forty-seven hour build weekends across India. No pitch decks, no idea stage, no theme for the sake of a theme — you arrive with a laptop, leave with something running, and the room is judged on what works. Every edition also doubles as a live audition: the people who stand out get a direct line into the next residency intake.\n        </p>\n        <div class=\"hk-band grid grid-cols-2 md:grid-cols-4 py-8 mb-16\" data-kid=\"1-95-3\">\n            <div class=\"pr-6\" data-kid=\"1-95-3-1\">\n                <div class=\"hk-num font-medium\" data-kid=\"1-95-3-1-1\" style=\"font-size:clamp(34px,3.6vw,50px);line-height:1;letter-spacing:-.03em;\">\n                    47\n                </div>\n                <div class=\"lbl mt-3\" data-kid=\"1-95-3-1-2\" style=\"color:rgba(8,8,7,.5);\">\n                    hours per edition\n                </div>\n            </div>\n            <div class=\"pr-6\" data-kid=\"1-95-3-2\">\n                <div class=\"hk-num font-medium\" data-kid=\"1-95-3-2-1\" style=\"font-size:clamp(34px,3.6vw,50px);line-height:1;letter-spacing:-.03em;\">\n                    06\n                </div>\n                <div class=\"lbl mt-3\" data-kid=\"1-95-3-2-2\" style=\"color:rgba(8,8,7,.5);\">\n                    cities in the calendar\n                </div>\n            </div>\n            <div class=\"pr-6\" data-kid=\"1-95-3-3\">\n                <div class=\"hk-num font-medium\" data-kid=\"1-95-3-3-1\" style=\"font-size:clamp(34px,3.6vw,50px);line-height:1;letter-spacing:-.03em;color:var(--volt);\">\n                    01\n                </div>\n                <div class=\"lbl mt-3\" data-kid=\"1-95-3-3-2\" style=\"color:rgba(8,8,7,.5);\">\n                    running now\n                </div>\n            </div>\n            <div data-kid=\"1-95-3-4\">\n                <div class=\"hk-num font-medium\" data-kid=\"1-95-3-4-1\" style=\"font-size:clamp(34px,3.6vw,50px);line-height:1;letter-spacing:-.03em;\">\n                    free\n                </div>\n                <div class=\"lbl mt-3\" data-kid=\"1-95-3-4-2\" style=\"color:rgba(8,8,7,.5);\">\n                    to enter, always\n                </div>\n            </div>\n        </div>\n        <div class=\"lbl grid gap-4 pb-4 hidden md:grid\" data-kid=\"1-95-4\" style=\"grid-template-columns:52px 1.1fr 1fr 1.4fr 132px;color:rgba(8,8,7,.4);border-bottom:1px solid rgba(8,8,7,.18);\">\n            <span data-kid=\"1-95-4-1\">\n                ed.\n            </span>\n            <span data-kid=\"1-95-4-2\">\n                city\n            </span>\n            <span data-kid=\"1-95-4-3\">\n                window\n            </span>\n            <span data-kid=\"1-95-4-4\">\n                format\n            </span>\n            <span class=\"text-right\" data-kid=\"1-95-4-5\">\n                status\n            </span>\n        </div>\n        <div data-kid=\"1-95-5\" id=\"hkList\">\n            <!-- edition 01 -->\n            <div class=\"hk-row grid gap-4 items-baseline py-7 md:grid-cols-[52px_1.1fr_1fr_1.4fr_132px]\" data-kid=\"1-95-5-1\" style=\"border-bottom:1px solid rgba(8,8,7,.14);\">\n                <span class=\"lbl m hk-num\" data-kid=\"1-95-5-1-1\" style=\"color:rgba(8,8,7,.35);\">\n                    01\n                </span>\n                <span class=\"hk-city font-medium\" data-kid=\"1-95-5-1-2\" style=\"font-size:24px;letter-spacing:-.02em;\">\n                    delhi\n                </span>\n                <span class=\"lbl m\" data-kid=\"1-95-5-1-3\" style=\"color:rgba(8,8,7,.6);\">\n                    aug 22 — aug 24\n                </span>\n                <span data-kid=\"1-95-5-1-4\" style=\"font-size:14px;line-height:1.5;color:rgba(8,8,7,.66);\">\n                    Opening edition. Two hundred builders, one floor, forty-seven hours.\n                </span>\n                <span class=\"lbl hk-status hk-status-live px-3 py-1.5 justify-self-start md:justify-self-end\" data-kid=\"1-95-5-1-5\">\n                    registration open\n                </span>\n            </div>\n            <!-- edition 02 -->\n            <div class=\"hk-row grid gap-4 items-baseline py-7 md:grid-cols-[52px_1.1fr_1fr_1.4fr_132px]\" data-kid=\"1-95-5-2\" style=\"border-bottom:1px solid rgba(8,8,7,.14);\">\n                <span class=\"lbl m hk-num\" data-kid=\"1-95-5-2-1\" style=\"color:rgba(8,8,7,.35);\">\n                    02\n                </span>\n                <span class=\"hk-city font-medium\" data-kid=\"1-95-5-2-2\" style=\"font-size:24px;letter-spacing:-.02em;\">\n                    bengaluru\n                </span>\n                <span class=\"lbl m\" data-kid=\"1-95-5-2-3\" style=\"color:rgba(8,8,7,.6);\">\n                    oct · dates soon\n                </span>\n                <span data-kid=\"1-95-5-2-4\" style=\"font-size:14px;line-height:1.5;color:rgba(8,8,7,.66);\">\n                    Infra and agents weekend, hosted inside a working engineering office.\n                </span>\n                <span class=\"lbl hk-status px-3 py-1.5 justify-self-start md:justify-self-end\" data-kid=\"1-95-5-2-5\" style=\"color:rgba(8,8,7,.62);\">\n                    venue locked\n                </span>\n            </div>\n            <!-- edition 03 -->\n            <div class=\"hk-row grid gap-4 items-baseline py-7 md:grid-cols-[52px_1.1fr_1fr_1.4fr_132px]\" data-kid=\"1-95-5-3\" style=\"border-bottom:1px solid rgba(8,8,7,.14);\">\n                <span class=\"lbl m hk-num\" data-kid=\"1-95-5-3-1\" style=\"color:rgba(8,8,7,.35);\">\n                    03\n                </span>\n                <span class=\"hk-city font-medium\" data-kid=\"1-95-5-3-2\" style=\"font-size:24px;letter-spacing:-.02em;\">\n                    mumbai\n                </span>\n                <span class=\"lbl m\" data-kid=\"1-95-5-3-3\" style=\"color:rgba(8,8,7,.6);\">\n                    nov · dates soon\n                </span>\n                <span data-kid=\"1-95-5-3-4\" style=\"font-size:14px;line-height:1.5;color:rgba(8,8,7,.66);\">\n                    Consumer weekend. Ship something a stranger can use by Sunday night.\n                </span>\n                <span class=\"lbl hk-status px-3 py-1.5 justify-self-start md:justify-self-end\" data-kid=\"1-95-5-3-5\" style=\"color:rgba(8,8,7,.62);\">\n                    scouting\n                </span>\n            </div>\n            <!-- edition 04 -->\n            <div class=\"hk-row grid gap-4 items-baseline py-7 md:grid-cols-[52px_1.1fr_1fr_1.4fr_132px]\" data-kid=\"1-95-5-4\" style=\"border-bottom:1px solid rgba(8,8,7,.14);\">\n                <span class=\"lbl m hk-num\" data-kid=\"1-95-5-4-1\" style=\"color:rgba(8,8,7,.35);\">\n                    04\n                </span>\n                <span class=\"hk-city font-medium\" data-kid=\"1-95-5-4-2\" style=\"font-size:24px;letter-spacing:-.02em;\">\n                    hyderabad\n                </span>\n                <span class=\"lbl m\" data-kid=\"1-95-5-4-3\" style=\"color:rgba(8,8,7,.6);\">\n                    dec · dates soon\n                </span>\n                <span data-kid=\"1-95-5-4-4\" style=\"font-size:14px;line-height:1.5;color:rgba(8,8,7,.66);\">\n                    Campus edition, run with student engineering societies.\n                </span>\n                <span class=\"lbl hk-status px-3 py-1.5 justify-self-start md:justify-self-end\" data-kid=\"1-95-5-4-5\" style=\"color:rgba(8,8,7,.62);\">\n                    scouting\n                </span>\n            </div>\n            <!-- your city -->\n            <div class=\"hk-row grid gap-4 items-baseline py-7 md:grid-cols-[52px_1.1fr_1fr_1.4fr_132px]\" data-kid=\"1-95-5-5\" style=\"border-bottom:1px solid rgba(8,8,7,.14);\">\n                <span class=\"lbl m hk-num\" data-kid=\"1-95-5-5-1\" style=\"color:rgba(8,8,7,.25);\">\n                    05\n                </span>\n                <span class=\"hk-city font-medium\" data-kid=\"1-95-5-5-2\" style=\"font-size:24px;letter-spacing:-.02em;color:rgba(8,8,7,.42);\">\n                    your city\n                </span>\n                <span class=\"lbl m\" data-kid=\"1-95-5-5-3\" style=\"color:rgba(8,8,7,.4);\">\n                    open slot\n                </span>\n                <span data-kid=\"1-95-5-5-4\" style=\"font-size:14px;line-height:1.5;color:rgba(8,8,7,.5);\">\n                    We bring the format, judging and prizes. You bring a room and a hundred builders.\n                </span>\n                <span class=\"lbl hk-status px-3 py-1.5 justify-self-start md:justify-self-end\" data-kid=\"1-95-5-5-5\" style=\"color:rgba(8,8,7,.5);border-style:dashed;\">\n                    host one\n                </span>\n            </div>\n        </div>\n        <div class=\"flex flex-wrap items-center gap-8 mt-14\" data-kid=\"1-95-6\">\n            <a class=\"btn-k px-8 py-4 lbl\" data-kid=\"1-95-6-1\" href=\"#\" style=\"text-decoration:none;\">\n                see the next hackathon\n                <span class=\"ar ml-2\" data-kid=\"1-95-6-1-1\">\n                    →\n                </span>\n            </a>\n            <a class=\"ulink lbl\" data-kid=\"1-95-6-2\" href=\"#\" style=\"color:rgba(8,8,7,.7);\">\n                host an edition in your city\n            </a>\n            <div class=\"lbl\" data-kid=\"1-95-6-3\" style=\"color:rgba(8,8,7,.42);\">\n                winners get a direct line into the next intake\n            </div>\n        </div>\n    </section>\n    <!-- ============ 9. APPLY ============ -->\n    <section class=\"px-8 py-28 lg:py-40\" data-kid=\"1-10\" id=\"apply\" style=\"background:var(--chalk);color:#0B0A09;border-top:1px solid rgba(8,8,7,.18);\">\n        <div class=\"lbl mb-14\" data-kid=\"1-10-1\" style=\"color:rgba(8,8,7,.42);\">\n            08 — apply\n        </div>\n        <h2 class=\"font-medium\" data-kid=\"1-10-2\" style=\"font-size:clamp(46px,8.4vw,132px);line-height:.9;letter-spacing:-.045em;max-width:1000px;\">\n            sixteen places. one first room.\n        </h2>\n        <div class=\"flex flex-wrap items-center gap-8 mt-14\" data-kid=\"1-10-3\">\n            <a class=\"btn-k px-9 py-5 lbl\" data-kid=\"1-10-3-1\" href=\"#\" style=\"text-decoration:none;font-size:11px;\">\n                apply for a place\n                <span class=\"ar ml-2\" data-kid=\"1-10-3-1-1\">\n                    →\n                </span>\n            </a>\n            <div class=\"lbl\" data-kid=\"1-10-3-2\" style=\"color:rgba(8,8,7,.5);\">\n                pilot 01 · delhi · sept 15 — oct 15\n            </div>\n        </div>\n    </section>\n    <!-- ============ FOOTER ============ -->\n    <footer data-kid=\"1-11\" style=\"background:var(--coal);\">\n        <!-- status strip -->\n        <div class=\"px-8 py-4 flex flex-wrap items-center justify-between gap-4 lbl\" data-kid=\"1-11-1\" style=\"background:var(--volt);color:var(--chalk);\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-11-1-1\">\n                <span data-kid=\"1-11-1-1-1\" id=\"fdot\" style=\"width:7px;height:7px;border-radius:999px;background:var(--chalk);display:inline-block;\">\n                </span>\n                applications open · pilot 01\n            </div>\n            <div class=\"hidden sm:block\" data-kid=\"1-11-1-2\" style=\"color:rgba(242,239,232,.8);\">\n                sept 15 — oct 15 · 30 days · delhi\n            </div>\n            <div class=\"tnum\" data-kid=\"1-11-1-3\">\n                16 places\n            </div>\n        </div>\n        <div class=\"px-8 pt-20\" data-kid=\"1-11-2\">\n            <div class=\"grid lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-start pb-16\" data-kid=\"1-11-2-1\" style=\"border-bottom:1px solid var(--line);\">\n                <div data-kid=\"1-11-2-1-1\">\n                    <div class=\"lbl mb-6\" data-kid=\"1-11-2-1-1-1\" style=\"color:rgba(242,239,232,.38);\">\n                        still deciding\n                    </div>\n                    <h3 class=\"font-medium\" data-kid=\"1-11-2-1-1-2\" style=\"font-size:clamp(28px,3.4vw,48px);line-height:1.02;letter-spacing:-.03em;max-width:620px;\">\n                        the room fills once. after that it is a waitlist.\n                    </h3>\n                    <div class=\"flex flex-wrap items-center gap-5 mt-8\" data-kid=\"1-11-2-1-1-3\">\n                        <a class=\"btn-o px-7 py-4 lbl\" data-kid=\"1-11-2-1-1-3-1\" href=\"#apply\" style=\"text-decoration:none;\">\n                            apply for a place\n                            <span class=\"ar ml-1\" data-kid=\"1-11-2-1-1-3-1-1\">\n                                →\n                            </span>\n                        </a>\n                        <a class=\"ulink lbl\" data-kid=\"1-11-2-1-1-3-2\" href=\"mailto:hello@hack47.org\" style=\"color:rgba(242,239,232,.7);\">\n                            or just email us\n                        </a>\n                    </div>\n                </div>\n                <div class=\"flex lg:justify-end\" data-kid=\"1-11-2-1-2\">\n                    <div data-kid=\"1-11-2-1-2-1\">\n                        <div class=\"grid\" data-kid=\"1-11-2-1-2-1-1\" id=\"fGrid\" style=\"grid-template-columns:repeat(4,16px);grid-auto-rows:34px;gap:6px;\">\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-1\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-2\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-3\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-4\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-5\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-6\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-7\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-8\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-9\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-10\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-11\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-12\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-13\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-14\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-15\">\n                            </div>\n                            <div class=\"fmark\" data-kid=\"1-11-2-1-2-1-1-16\">\n                            </div>\n                        </div>\n                        <div class=\"lbl mt-4\" data-kid=\"1-11-2-1-2-1-2\" style=\"color:rgba(242,239,232,.3);\">\n                            sixteen lights\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- team -->\n            <div class=\"py-16\" data-kid=\"1-11-2-15\" style=\"border-bottom:1px solid var(--line);\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 mb-10\" data-kid=\"1-11-2-15-1\">\n                    <div class=\"lbl\" data-kid=\"1-11-2-15-1-1\" style=\"color:rgba(242,239,232,.38);\">\n                        the team behind this\n                    </div>\n                    <div class=\"lbl\" data-kid=\"1-11-2-15-1-2\" style=\"color:rgba(242,239,232,.28);\">\n                        four people · delhi\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8\" data-kid=\"1-11-2-15-2\" id=\"teamGrid\">\n                    <div class=\"tm flex items-center gap-4\" data-kid=\"1-11-2-15-2-1\">\n                        <img alt=\"Team member portrait placeholder\" class=\"tm-img shrink-0\" data-kid=\"1-11-2-15-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/160?u=h47-team-lead\" style=\"width:52px;height:52px;object-fit:cover;\"/>\n                        <div data-kid=\"1-11-2-15-2-1-2\">\n                            <div class=\"font-medium\" data-kid=\"1-11-2-15-2-1-2-1\" style=\"font-size:15px;letter-spacing:-.01em;\">\n                                [name]\n                            </div>\n                            <div class=\"lbl mt-1.5\" data-kid=\"1-11-2-15-2-1-2-2\" style=\"color:rgba(242,239,232,.42);\">\n                                the house\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"tm flex items-center gap-4\" data-kid=\"1-11-2-15-2-2\">\n                        <img alt=\"Team member portrait placeholder\" class=\"tm-img shrink-0\" data-kid=\"1-11-2-15-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/160?u=h47-team-prog\" style=\"width:52px;height:52px;object-fit:cover;\"/>\n                        <div data-kid=\"1-11-2-15-2-2-2\">\n                            <div class=\"font-medium\" data-kid=\"1-11-2-15-2-2-2-1\" style=\"font-size:15px;letter-spacing:-.01em;\">\n                                [name]\n                            </div>\n                            <div class=\"lbl mt-1.5\" data-kid=\"1-11-2-15-2-2-2-2\" style=\"color:rgba(242,239,232,.42);\">\n                                programme & intake\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"tm flex items-center gap-4\" data-kid=\"1-11-2-15-2-3\">\n                        <img alt=\"Team member portrait placeholder\" class=\"tm-img shrink-0\" data-kid=\"1-11-2-15-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/160?u=h47-team-hacks\" style=\"width:52px;height:52px;object-fit:cover;\"/>\n                        <div data-kid=\"1-11-2-15-2-3-2\">\n                            <div class=\"font-medium\" data-kid=\"1-11-2-15-2-3-2-1\" style=\"font-size:15px;letter-spacing:-.01em;\">\n                                [name]\n                            </div>\n                            <div class=\"lbl mt-1.5\" data-kid=\"1-11-2-15-2-3-2-2\" style=\"color:rgba(242,239,232,.42);\">\n                                hackathons\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"tm flex items-center gap-4\" data-kid=\"1-11-2-15-2-4\">\n                        <img alt=\"Team member portrait placeholder\" class=\"tm-img shrink-0\" data-kid=\"1-11-2-15-2-4-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/160?u=h47-team-part\" style=\"width:52px;height:52px;object-fit:cover;\"/>\n                        <div data-kid=\"1-11-2-15-2-4-2\">\n                            <div class=\"font-medium\" data-kid=\"1-11-2-15-2-4-2-1\" style=\"font-size:15px;letter-spacing:-.01em;\">\n                                [name]\n                            </div>\n                            <div class=\"lbl mt-1.5\" data-kid=\"1-11-2-15-2-4-2-2\" style=\"color:rgba(242,239,232,.42);\">\n                                partners & campus\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-6 mt-10\" data-kid=\"1-11-2-15-3\">\n                    <a class=\"ulink lbl\" data-kid=\"1-11-2-15-3-1\" href=\"mailto:hello@hack47.org\" style=\"color:var(--volt);\">\n                        work on hack47 with us\n                    </a>\n                    <span class=\"lbl\" data-kid=\"1-11-2-15-3-2\" style=\"color:rgba(242,239,232,.3);\">\n                        we are two roles short for pilot 01\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid md:grid-cols-4 gap-10 py-16\" data-kid=\"1-11-2-2\">\n                <div data-kid=\"1-11-2-2-1\">\n                    <div class=\"text-[19px] font-semibold tracking-tight mb-4\" data-kid=\"1-11-2-2-1-1\">\n                        hack47\n                    </div>\n                    <p data-kid=\"1-11-2-2-1-2\" style=\"font-size:13px;line-height:1.6;color:rgba(242,239,232,.5);max-width:230px;\">\n                        A thirty-day builder residency in a Delhi villa, and the first step toward a permanent founder campus.\n                    </p>\n                </div>\n                <div data-kid=\"1-11-2-2-2\">\n                    <div class=\"lbl mb-5\" data-kid=\"1-11-2-2-2-1\" style=\"color:rgba(242,239,232,.38);\">\n                        the house\n                    </div>\n                    <ul class=\"space-y-2.5\" data-kid=\"1-11-2-2-2-2\" style=\"list-style:none;padding:0;font-size:14px;\">\n                        <li data-kid=\"1-11-2-2-2-2-1\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-2-2-1-1\" href=\"#pilot\">\n                                pilot 01\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-2\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-2-2-2-1\" href=\"#mentors\">\n                                mentors\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-3\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-2-2-3-1\" href=\"#partners\">\n                                partners\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-4\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-2-2-4-1\" href=\"#house\">\n                                the 30 days\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-5\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-2-2-5-1\" href=\"#campus\">\n                                the campus\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-6\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-2-2-6-1\" href=\"#hackathons\">\n                                hackathons\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-11-2-2-3\">\n                    <div class=\"lbl mb-5\" data-kid=\"1-11-2-2-3-1\" style=\"color:rgba(242,239,232,.38);\">\n                        get involved\n                    </div>\n                    <ul class=\"space-y-2.5\" data-kid=\"1-11-2-2-3-2\" style=\"list-style:none;padding:0;font-size:14px;\">\n                        <li data-kid=\"1-11-2-2-3-2-1\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-3-2-1-1\" href=\"#apply\">\n                                apply for a place\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-2\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-3-2-2-1\" href=\"#partners\">\n                                become a partner\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-3\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-3-2-3-1\" href=\"#mentors\">\n                                suggest a mentor\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-4\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-3-2-4-1\" href=\"#campus\">\n                                back the campus\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-5\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-3-2-5-1\" href=\"#hackathons\">\n                                host a hackathon\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-6\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-3-2-6-1\" href=\"mailto:hello@hack47.org\">\n                                join the team\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-11-2-2-4\">\n                    <div class=\"lbl mb-5\" data-kid=\"1-11-2-2-4-1\" style=\"color:rgba(242,239,232,.38);\">\n                        elsewhere\n                    </div>\n                    <ul class=\"space-y-2.5\" data-kid=\"1-11-2-2-4-2\" style=\"list-style:none;padding:0;font-size:14px;\">\n                        <li data-kid=\"1-11-2-2-4-2-1\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-4-2-1-1\" href=\"mailto:hello@hack47.org\">\n                                hello@hack47.org\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-4-2-2\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-4-2-2-1\" href=\"#\">\n                                x / twitter ↗\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-4-2-3\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-4-2-3-1\" href=\"#\">\n                                linkedin ↗\n                            </a>\n                        </li>\n                        <li data-kid=\"1-11-2-2-4-2-4\">\n                            <a class=\"flink\" data-kid=\"1-11-2-2-4-2-4-1\" href=\"#\">\n                                instagram ↗\n                            </a>\n                        </li>\n                    </ul>\n                    <div class=\"lbl mt-6\" data-kid=\"1-11-2-2-4-3\" style=\"color:rgba(242,239,232,.3);\">\n                        delhi, india\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- oversized wordmark -->\n        <div class=\"px-8 overflow-hidden\" data-kid=\"1-11-3\" style=\"border-top:1px solid var(--line);\">\n            <div class=\"font-semibold select-none\" data-kid=\"1-11-3-1\" style=\"font-size:clamp(76px,20.5vw,300px);line-height:.86;letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1px rgba(242,239,232,.2);padding-top:26px;\">\n                hack47\n            </div>\n        </div>\n        <div class=\"px-8 py-8 flex flex-wrap justify-between gap-4 lbl\" data-kid=\"1-11-4\" style=\"border-top:1px solid var(--line);color:rgba(242,239,232,.34);\">\n            <div data-kid=\"1-11-4-1\">\n                © 2026 hack47 · built in delhi\n            </div>\n            <div class=\"flex flex-wrap gap-6\" data-kid=\"1-11-4-2\">\n                <a data-kid=\"1-11-4-2-1\" href=\"#\" style=\"color:inherit;text-decoration:none;\">\n                    code of conduct\n                </a>\n                <a data-kid=\"1-11-4-2-4\" href=\"#\" style=\"color:inherit;text-decoration:none;\">\n                    faq\n                </a>\n                <a data-kid=\"1-11-4-2-5\" href=\"#\" style=\"color:inherit;text-decoration:none;\">\n                    press kit\n                </a>\n                <a data-kid=\"1-11-4-2-2\" href=\"#\" style=\"color:inherit;text-decoration:none;\">\n                    privacy\n                </a>\n                <a data-kid=\"1-11-4-2-3\" href=\"mailto:hello@hack47.org\" style=\"color:inherit;text-decoration:none;\">\n                    contact\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n/* ---------- selection funnel: 40,000 stream down into sixteen lights ---------- */\n(function(){\n  var c = document.getElementById('selFunnel');\n  if(!c) return;\n  var ctx = c.getContext('2d');\n  var dpr = Math.min(2, window.devicePixelRatio || 1);\n  var W = 1, H = 1;\n  var GATE = 0.68, GW = 0.13, CELLS = 16;\n  var lit = [], absorbed = 0, nextCell = 0;\n  for (var q = 0; q < CELLS; q++) lit.push(0);\n\n  function resize(){\n    var r = c.getBoundingClientRect();\n    W = Math.max(1, r.width); H = Math.max(1, r.height);\n    c.width = Math.round(W * dpr); c.height = Math.round(H * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n  function mk(p){\n    p.x = Math.random();\n    p.y = -Math.random() * 0.55;\n    p.v = 0.0020 + Math.random() * 0.0046;\n    p.w = Math.random() < 0.1 ? 2.2 : 1.2;\n    p.o = 0.22 + Math.random() * 0.6;\n    return p;\n  }\n  var P = [];\n  for (var i = 0; i < 900; i++){\n    var p = mk({});\n    p.y = Math.random() * GATE; /* seed mid-flow so the funnel is full immediately */\n    P.push(p);\n  }\n  for (var z = 0; z < 6; z++){ lit[nextCell++] = 1; } /* first places already taken */\n\n  function frame(){\n    ctx.clearRect(0, 0, W, H);\n    var gy = Math.round(H * GATE), cx = W * 0.5, hg = W * GW * 0.5;\n\n    /* funnel walls */\n    ctx.strokeStyle = 'rgba(242,239,232,.26)';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(0.5, 0); ctx.lineTo(cx - hg, gy);\n    ctx.moveTo(W - 0.5, 0); ctx.lineTo(cx + hg, gy);\n    ctx.stroke();\n\n    /* falling applications */\n    for (var i = 0; i < P.length; i++){\n      var p = P[i];\n      p.y += p.v;\n      if (p.y >= GATE){\n        absorbed++;\n        if (absorbed % 70 === 0 && nextCell < CELLS){ lit[nextCell++] = 1; }\n        mk(p); continue;\n      }\n      if (p.y <= 0) continue;\n      var t = p.y / GATE;\n      var e = t * t;\n      var x = cx + (p.x - 0.5) * W * (1 - e * (1 - GW));\n      var y = p.y * H;\n      ctx.fillStyle = 'rgba(242,239,232,' + (p.o * (0.4 + 0.6 * t)).toFixed(3) + ')';\n      ctx.fillRect(x, y, p.w, p.w * 2.6);\n    }\n\n    /* the gate */\n    ctx.fillStyle = 'rgba(242,239,232,.92)';\n    ctx.fillRect(cx - hg, gy, hg * 2, 2);\n\n    /* sixteen lights */\n    var top = gy + 30;\n    var bh = Math.max(16, H - top - 26);\n    var span = W * 0.88, x0 = (W - span) / 2, cw = span / CELLS;\n    for (var k = 0; k < CELLS; k++){\n      var bx = x0 + k * cw + cw * 0.2, bw = cw * 0.6;\n      if (lit[k]){\n        ctx.fillStyle = 'rgba(242,239,232,.96)';\n        ctx.fillRect(bx, top, bw, bh);\n      } else {\n        ctx.strokeStyle = 'rgba(242,239,232,.32)';\n        ctx.strokeRect(Math.round(bx) + 0.5, top + 0.5, Math.round(bw), bh);\n      }\n    }\n    requestAnimationFrame(frame);\n  }\n  resize();\n  window.addEventListener('resize', resize);\n  requestAnimationFrame(frame);\n})();\n\n/* ---------- hackathon rows + team reveal ---------- */\ngsap.from('#hkList .hk-row', {\n  scrollTrigger: { trigger: '#hkList', start: 'top 86%', once: true },\n  y: 18, opacity: 0, duration: .6, stagger: .07, ease: 'power2.out'\n});\ngsap.from('#teamGrid .tm', {\n  scrollTrigger: { trigger: '#teamGrid', start: 'top 92%', once: true },\n  y: 14, opacity: 0, duration: .5, stagger: .07, ease: 'power2.out'\n});\n\n/* ---------- 40,000 counts down to 16 ---------- */\n(function(){\n  var el = document.getElementById('bigSix');\n  if(!el) return;\n  var o = { v: 40000 };\n  ScrollTrigger.create({\n    trigger: el, start: 'top 82%', once: true,\n    onEnter: function(){\n      gsap.to(o, {\n        v: 16, duration: 2.4, ease: 'expo.inOut',\n        onUpdate: function(){ el.textContent = Math.round(o.v).toLocaleString('en-US'); },\n        onComplete: function(){ el.textContent = '16'; }\n      });\n    }\n  });\n})();\n\n/* ---------- header ---------- */\nScrollTrigger.create({\n  start: 'top -70', end: 99999,\n  onUpdate: function(self){\n    var h = document.getElementById('hdr'), r = document.getElementById('hdr-rule');\n    if(self.scroll() > 70){ h.style.background = '#0B0A09'; r.style.opacity = 1; }\n    else { h.style.background = 'transparent'; r.style.opacity = 0; }\n  }\n});\n\n/* ---------- hero apertures ---------- */\ndocument.querySelectorAll('#heroGrid .glow').forEach(function(el){\n  gsap.to(el, {\n    opacity: gsap.utils.random(0.35, 1),\n    duration: gsap.utils.random(1.6, 3.4),\n    delay: gsap.utils.random(0, 4),\n    repeat: -1, yoyo: true, ease: 'sine.inOut'\n  });\n});\ngsap.from('#pilot h1', { y: 34, opacity: 0, duration: 1.1, ease: 'power3.out', delay: .15 });\n\n/* ---------- generic reveals ---------- */\ngsap.utils.toArray('.reveal').forEach(function(el){\n  gsap.from(el, { scrollTrigger: { trigger: el, start: 'top 86%' }, y: 26, opacity: 0, duration: .85, ease: 'power2.out' });\n});\n\n/* ---------- premise apertures fill ---------- */\ngsap.to('#premGrid .ap-fill', {\n  scrollTrigger: { trigger: '#premGrid', start: 'top 80%', once: true },\n  opacity: 1, duration: .45, stagger: .06, ease: 'none'\n});\n\n/* ---------- 30 day ticks ---------- */\n(function(){\n  var t = document.getElementById('dayTicks');\n  if(!t) return;\n  var marks = [1,15,30];\n  for(var i=1;i<=30;i++){\n    var s = document.createElement('div');\n    s.className = 'tick' + (marks.indexOf(i)>-1 ? ' tick-on' : '');\n    s.style.height = marks.indexOf(i)>-1 ? '100%' : (i%5===0 ? '62%' : '38%');\n    t.appendChild(s);\n  }\n  gsap.from('#dayTicks .tick', {\n    scrollTrigger: { trigger: '#dayTicks', start: 'top 88%', once: true },\n    scaleY: 0, transformOrigin: 'bottom', duration: .5, stagger: .022, ease: 'power2.out'\n  });\n})();\n\n/* ---------- mentor slider ---------- */\n(function(){\n  var tr = document.getElementById('mtrack');\n  if(!tr) return;\n  var cards = tr.querySelectorAll('.mcard');\n  var bar = document.getElementById('mbar');\n  var cnt = document.getElementById('mcount');\n  function step(){ return cards.length ? cards[0].getBoundingClientRect().width + 20 : 320; }\n  function pad(n){ return (n<10?'0':'') + n; }\n  function sync(){\n    var max = tr.scrollWidth - tr.clientWidth;\n    var p = max > 0 ? tr.scrollLeft / max : 0;\n    var visible = Math.max(1, Math.round(tr.clientWidth / step()));\n    if(bar) bar.style.width = Math.max(12, (visible / cards.length) * 100 + p * (100 - (visible / cards.length) * 100)) + '%';\n    var idx = Math.min(cards.length, Math.round(tr.scrollLeft / step()) + 1);\n    if(cnt) cnt.textContent = pad(idx) + ' / ' + pad(cards.length);\n  }\n  document.getElementById('mnext').addEventListener('click', function(){ tr.scrollBy({ left: step(), behavior: 'smooth' }); });\n  document.getElementById('mprev').addEventListener('click', function(){ tr.scrollBy({ left: -step(), behavior: 'smooth' }); });\n  tr.addEventListener('scroll', sync);\n  window.addEventListener('resize', sync);\n  sync();\n})();\n\n/* ---------- partner logo wall reveal ---------- */\ngsap.from('#logoWall .logo-cell', {\n  scrollTrigger: { trigger: '#logoWall', start: 'top 84%', once: true },\n  y: 14, opacity: 0, duration: .5, stagger: .028, ease: 'power2.out'\n});\n\n/* ---------- gallery parallax ---------- */\ngsap.utils.toArray('.gal-img').forEach(function(img){\n  gsap.fromTo(img, { y: -7 }, { y: 7, ease: 'none', scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true } });\n});\n\n/* ---------- campus roadmap line ---------- */\ngsap.to('#netLine', { width: '100%', ease: 'none', scrollTrigger: { trigger: '#campus', start: 'top 62%', end: 'bottom 85%', scrub: .8 } });\n\n/* ---------- footer sixteen lights ---------- */\ngsap.to('#fGrid .fmark', {\n  scrollTrigger: { trigger: '#fGrid', start: 'top 92%', once: true },\n  backgroundColor: '#285AF7', duration: .4, stagger: { amount: .8, from: 'random' }, ease: 'none'\n});\ngsap.to('#fdot', { opacity: .25, duration: 1, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n</script>\n",
      "comments": [],
      "created": "2026-09-11T04:24:53.797839+00:00",
      "modified": "2026-09-11T05:12:09.461158+00:00",
      "id": "var_8efb54de8991",
      "viewportScrollY": 3518
    },
    "var_afbda14d3ddf": {
      "type": "variant",
      "label": "V2 — The Intake Field (dark technical)",
      "parentId": "var_8efb54de8991",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Azeret+Mono:wght@300;400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root{\n  --slate:#091018;\n  --deck:#111B23;\n  --raised:#19252E;\n  --bd:#29404B;\n  --ink:#E8EFF0;\n  --muted:#8AA3AD;\n  --cyan:#54D5C0;\n  --ember:#D67148;\n}\n.d{font-family:'Inter Tight',system-ui,sans-serif;}\n.m{font-family:'Azeret Mono',ui-monospace,monospace;}\n.lbl{font-family:'Azeret Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;}\n.tnum{font-variant-numeric:tabular-nums;}\n.pnl{background:var(--deck);border:1px solid var(--bd);border-radius:16px;}\n.pnl-r{background:var(--raised);border:1px solid var(--bd);border-radius:16px;}\n.btn-c{border:1px solid var(--cyan);color:var(--cyan);background:transparent;border-radius:999px;transition:background .18s ease,color .18s ease;}\n.btn-c:hover{background:var(--cyan);color:#04120F;}\n.tlink{color:var(--muted);text-decoration:none;transition:color .16s ease;}\n.tlink:hover{color:var(--ink);}\n.idx-item{color:#4C6672;transition:color .2s ease;}\n.idx-item.on{color:var(--cyan);}\n.mx-dot{width:9px;height:9px;border-radius:999px;background:var(--cyan);display:inline-block;}\n.mx-none{width:9px;height:1px;background:#334C57;display:inline-block;}\n.mx-row{transition:background .18s ease;}\n.mx-row:hover{background:rgba(84,213,192,.05);}\n.tp{border-color:var(--bd);cursor:pointer;}\n.tp.sel{border-color:var(--cyan);background:var(--raised);}\n.acc-body{display:grid;grid-template-rows:0fr;overflow:hidden;}\n.tp.sel .acc-body{grid-template-rows:1fr;}\n.acc-body>div{min-height:0;}\n.cell{border:1px solid rgba(84,213,192,.42);}\n.cell-on{background:var(--ember);border-color:var(--ember);}\n.imgt{filter:grayscale(.4) contrast(1.06) brightness(.8);}\n</style>\n<div class=\"d antialiased\" data-kid=\"1\" style=\"background:var(--slate);color:var(--ink);\">\n    <!-- ===== HEADER ===== -->\n    <header class=\"fixed top-0 left-0 right-0 z-50\" data-kid=\"1-1\" id=\"hdr\" style=\"height:52px;background:transparent;border-bottom:1px solid transparent;\">\n        <div class=\"h-full px-8 flex items-center justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\">\n                <span data-kid=\"1-1-1-1-1\" style=\"width:12px;height:12px;border-radius:999px;background:var(--cyan);display:inline-block;\">\n                </span>\n                <span class=\"text-[17px] font-semibold tracking-tight\" data-kid=\"1-1-1-1-2\">\n                    hack47\n                </span>\n            </div>\n            <div class=\"hidden md:block lbl\" data-kid=\"1-1-1-2\" style=\"color:var(--muted);\">\n                pilot 01 / delhi\n            </div>\n            <a class=\"btn-c lbl px-5 py-2\" data-kid=\"1-1-1-3\" href=\"#apply\" style=\"text-decoration:none;\">\n                request a place\n            </a>\n        </div>\n    </header>\n    <!-- ===== SIDE INDEX ===== -->\n    <div class=\"hidden xl:block fixed z-40\" data-kid=\"1-2\" id=\"sideIdx\" style=\"right:34px;top:50%;transform:translateY(-50%);\">\n        <div class=\"flex\" data-kid=\"1-2-1\">\n            <div class=\"relative mr-4\" data-kid=\"1-2-1-1\" style=\"width:1px;background:#22333C;\">\n                <div data-dynamic=\"true\" data-kid=\"1-2-1-1-1\" data-name=\"side index progress bar\" data-reason=\"height animated by scroll position\" id=\"idxBar\" style=\"position:absolute;left:0;top:0;width:1px;height:0%;background:var(--cyan);\">\n                </div>\n            </div>\n            <div class=\"space-y-3.5\" data-kid=\"1-2-1-2\">\n                <div class=\"idx-item lbl on\" data-kid=\"1-2-1-2-1\" data-t=\"#hero\">\n                    01 intake\n                </div>\n                <div class=\"idx-item lbl\" data-kid=\"1-2-1-2-2\" data-t=\"#selection\">\n                    02 16 places\n                </div>\n                <div class=\"idx-item lbl\" data-kid=\"1-2-1-2-3\" data-t=\"#premise\">\n                    03 premise\n                </div>\n                <div class=\"idx-item lbl\" data-kid=\"1-2-1-2-4\" data-t=\"#mentors\">\n                    04 mentors\n                </div>\n                <div class=\"idx-item lbl\" data-kid=\"1-2-1-2-5\" data-t=\"#support\">\n                    05 support\n                </div>\n                <div class=\"idx-item lbl\" data-kid=\"1-2-1-2-6\" data-t=\"#house\">\n                    06 house\n                </div>\n                <div class=\"idx-item lbl\" data-kid=\"1-2-1-2-7\" data-t=\"#network\">\n                    07 network\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- ===== 1. INTAKE FIELD HERO ===== -->\n    <section class=\"relative overflow-hidden\" data-kid=\"1-3\" id=\"hero\" style=\"height:90vh;min-height:660px;\">\n        <canvas class=\"absolute inset-0 w-full h-full\" data-dynamic=\"true\" data-kid=\"1-3-1\" data-name=\"hero background canvas\" data-reason=\"canvas rendered and animated by script\" id=\"field\">\n        </canvas>\n        <div class=\"absolute inset-0\" data-kid=\"1-3-2\" style=\"background:radial-gradient(120% 90% at 62% 34%,rgba(9,16,24,0) 0%,rgba(9,16,24,.55) 62%,var(--slate) 100%);\">\n        </div>\n        <div class=\"absolute\" data-kid=\"1-3-3\" style=\"left:48px;bottom:120px;max-width:760px;\">\n            <div class=\"lbl mb-6\" data-kid=\"1-3-3-1\" style=\"color:var(--cyan);\">\n                pilot 01 · 30 days · sept 15 — oct 15\n            </div>\n            <h1 class=\"font-medium\" data-kid=\"1-3-3-2\" id=\"h1\" style=\"font-size:clamp(36px,4.6vw,66px);line-height:1.03;letter-spacing:-.03em;\">\n                forty thousand reached.\n                <span data-kid=\"1-3-3-2-1\" style=\"color:var(--muted);\">\n                    sixteen places in one Delhi house.\n                </span>\n            </h1>\n            <a class=\"btn-c lbl inline-block mt-9 px-6 py-3\" data-kid=\"1-3-3-3\" href=\"#apply\" style=\"text-decoration:none;\">\n                request a place →\n            </a>\n        </div>\n        <!-- legend -->\n        <div class=\"absolute hidden md:block\" data-kid=\"1-3-4\" style=\"right:200px;bottom:120px;\">\n            <div class=\"pnl px-6 py-5\" data-kid=\"1-3-4-1\" style=\"min-width:210px;backdrop-filter:blur(2px);\">\n                <div class=\"flex justify-between items-baseline py-1.5\" data-kid=\"1-3-4-1-1\">\n                    <span class=\"lbl\" data-kid=\"1-3-4-1-1-1\" style=\"color:var(--muted);\">\n                        reach\n                    </span>\n                    <span class=\"m tnum\" data-kid=\"1-3-4-1-1-2\" style=\"font-size:14px;\">\n                        40,000+\n                    </span>\n                </div>\n                <div data-kid=\"1-3-4-1-2\" style=\"height:1px;background:var(--bd);\">\n                </div>\n                <div class=\"flex justify-between items-baseline py-1.5\" data-kid=\"1-3-4-1-3\">\n                    <span class=\"lbl\" data-kid=\"1-3-4-1-3-1\" style=\"color:var(--muted);\">\n                        places\n                    </span>\n                    <span class=\"m tnum\" data-kid=\"1-3-4-1-3-2\" style=\"font-size:14px;color:var(--ember);\">\n                        16\n                    </span>\n                </div>\n                <div data-kid=\"1-3-4-1-4\" style=\"height:1px;background:var(--bd);\">\n                </div>\n                <div class=\"flex justify-between items-baseline py-1.5\" data-kid=\"1-3-4-1-5\">\n                    <span class=\"lbl\" data-kid=\"1-3-4-1-5-1\" style=\"color:var(--muted);\">\n                        location\n                    </span>\n                    <span class=\"m\" data-kid=\"1-3-4-1-5-2\" style=\"font-size:14px;\">\n                        delhi\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== 2. SELECTION MECHANICS ===== -->\n    <section class=\"relative px-8 py-24 lg:py-32\" data-kid=\"1-4\" id=\"selection\" style=\"background:var(--slate);\">\n        <div class=\"lbl mb-16\" data-kid=\"1-4-1\" style=\"color:var(--muted);\">\n            02 / selection mechanics\n        </div>\n        <div class=\"grid lg:grid-cols-[40%_60%] gap-14 lg:gap-20 items-center\" data-kid=\"1-4-2\">\n            <!-- floor plan -->\n            <div data-kid=\"1-4-2-1\">\n                <div class=\"pnl p-7\" data-kid=\"1-4-2-1-1\">\n                    <div class=\"lbl mb-5\" data-kid=\"1-4-2-1-1-1\" style=\"color:var(--muted);\">\n                        delhi villa · place plan\n                    </div>\n                    <div aria-label=\"16 available cohort places\" class=\"grid\" data-dynamic=\"true\" data-kid=\"1-4-2-1-1-2\" data-name=\"16 available cohort places grid\" data-reason=\"grid cells injected by script\" id=\"planGrid\" style=\"grid-template-columns:repeat(4,1fr);gap:10px;\">\n                    </div>\n                    <div class=\"flex items-center gap-6 mt-6\" data-kid=\"1-4-2-1-1-3\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-4-2-1-1-3-1\">\n                            <span data-kid=\"1-4-2-1-1-3-1-1\" style=\"width:12px;height:12px;background:var(--ember);display:inline-block;\">\n                            </span>\n                            <span class=\"lbl\" data-kid=\"1-4-2-1-1-3-1-2\" style=\"color:var(--muted);\">\n                                place\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-4-2-1-1-3-2\">\n                            <span data-kid=\"1-4-2-1-1-3-2-1\" style=\"width:12px;height:12px;border:1px solid rgba(84,213,192,.42);display:inline-block;\">\n                            </span>\n                            <span class=\"lbl\" data-kid=\"1-4-2-1-1-3-2-2\" style=\"color:var(--muted);\">\n                                plan outline\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- data -->\n            <div data-kid=\"1-4-2-2\">\n                <div class=\"tnum font-medium\" data-kid=\"1-4-2-2-1\" style=\"font-size:clamp(74px,11vw,168px);line-height:.84;letter-spacing:-.05em;\">\n                    40,000+\n                </div>\n                <div class=\"lbl mt-4\" data-kid=\"1-4-2-2-2\" style=\"color:var(--muted);\">\n                    builders reached across india\n                </div>\n                <div data-kid=\"1-4-2-2-3\" style=\"height:1px;background:var(--bd);margin:38px 0;\">\n                </div>\n                <div class=\"flex flex-wrap items-end gap-10\" data-kid=\"1-4-2-2-4\">\n                    <div data-kid=\"1-4-2-2-4-1\">\n                        <div class=\"tnum font-medium\" data-kid=\"1-4-2-2-4-1-1\" style=\"font-size:clamp(56px,7vw,104px);line-height:.86;letter-spacing:-.04em;color:var(--ember);\">\n                            16\n                        </div>\n                        <div class=\"lbl mt-3\" data-kid=\"1-4-2-2-4-1-2\" style=\"color:var(--muted);\">\n                            places in pilot 01\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-2-2-4-2\">\n                        <div class=\"tnum font-medium\" data-kid=\"1-4-2-2-4-2-1\" style=\"font-size:clamp(56px,7vw,104px);line-height:.86;letter-spacing:-.04em;\">\n                            30\n                        </div>\n                        <div class=\"lbl mt-3\" data-kid=\"1-4-2-2-4-2-2\" style=\"color:var(--muted);\">\n                            days in the house\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-10\" data-kid=\"1-4-2-2-5\" style=\"font-size:19px;line-height:1.5;color:var(--muted);max-width:520px;\">\n                    One room. Intentionally small. Outreach carried Pilot 01 to more than forty thousand builders across India; sixteen of them get a bed, a desk, and thirty days.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ===== 3. PREMISE ===== -->\n    <section class=\"px-8 py-24 lg:py-32\" data-kid=\"1-5\" id=\"premise\" style=\"background:var(--slate);\">\n        <div class=\"grid lg:grid-cols-[1fr_1.4fr] gap-12\" data-kid=\"1-5-1\">\n            <div data-kid=\"1-5-1-1\">\n                <div class=\"lbl mb-5\" data-kid=\"1-5-1-1-1\" style=\"color:var(--muted);\">\n                    03 / pilot premise\n                </div>\n                <div data-kid=\"1-5-1-1-2\" style=\"width:52px;height:1px;background:var(--cyan);\">\n                </div>\n            </div>\n            <div data-kid=\"1-5-1-2\" style=\"max-width:680px;\">\n                <h2 class=\"reveal font-medium mb-8\" data-kid=\"1-5-1-2-1\" style=\"font-size:clamp(28px,3.4vw,44px);line-height:1.12;letter-spacing:-.025em;\">\n                    Hack47 begins with a practical proposition.\n                </h2>\n                <p class=\"reveal\" data-kid=\"1-5-1-2-2\" style=\"font-size:19px;line-height:1.58;color:var(--muted);\">\n                    Put sixteen serious builders in one functioning house for thirty days, give them room to work, and bring the right people through the door. That is the whole design.\n                </p>\n                <p class=\"reveal mt-7\" data-kid=\"1-5-1-2-3\" style=\"font-size:19px;line-height:1.58;color:var(--muted);\">\n                    Not a lecture series. Not a demo-day factory. Pilot 01 is the first run, and we would rather be honest about that than pretend to a track record we have not earned yet.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ===== 4. MENTOR TRANSMISSIONS ===== -->\n    <section class=\"px-8 py-24 lg:py-32\" data-kid=\"1-6\" id=\"mentors\" style=\"background:var(--slate);\">\n        <div class=\"flex flex-wrap items-end justify-between gap-8 mb-14\" data-kid=\"1-6-1\">\n            <div data-kid=\"1-6-1-1\">\n                <div class=\"lbl mb-5\" data-kid=\"1-6-1-1-1\" style=\"color:var(--muted);\">\n                    04 / mentor transmissions\n                </div>\n                <h2 class=\"font-medium\" data-kid=\"1-6-1-1-2\" style=\"font-size:clamp(30px,3.8vw,52px);line-height:1.05;letter-spacing:-.03em;max-width:620px;\">\n                    the mentors coming into the house\n                </h2>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-6-1-2\" style=\"color:var(--cyan);\">\n                <span class=\"ti ti-building-broadcast-tower\" data-kid=\"1-6-1-2-1\" style=\"font-size:22px;\">\n                </span>\n                <span class=\"lbl\" data-kid=\"1-6-1-2-2\">\n                    roster in progress\n                </span>\n            </div>\n        </div>\n        <div class=\"grid md:grid-cols-12 gap-5\" data-kid=\"1-6-2\">\n            <!-- featured -->\n            <div class=\"tp pnl sel md:col-span-7 p-7\" data-kid=\"1-6-2-1\" style=\"border-width:1px;\">\n                <div class=\"flex items-start gap-6\" data-kid=\"1-6-2-1-1\">\n                    <img alt=\"Mentor portrait placeholder\" data-kid=\"1-6-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/400?u=h47-tx-infra\" style=\"width:112px;height:132px;object-fit:cover;border-radius:10px;filter:grayscale(.6) contrast(1.05);\"/>\n                    <div class=\"flex-1\" data-kid=\"1-6-2-1-1-2\">\n                        <div class=\"lbl mb-2\" data-kid=\"1-6-2-1-1-2-1\" style=\"color:var(--cyan);\">\n                            tx 01 · in house, two weeks\n                        </div>\n                        <div class=\"font-medium\" data-kid=\"1-6-2-1-1-2-2\" style=\"font-size:24px;letter-spacing:-.02em;\">\n                            [mentor name]\n                        </div>\n                        <div class=\"lbl mt-1.5\" data-kid=\"1-6-2-1-1-2-3\" style=\"color:var(--muted);\">\n                            staff engineer, infrastructure\n                        </div>\n                    </div>\n                </div>\n                <div data-kid=\"1-6-2-1-2\" style=\"height:1px;background:var(--bd);margin:22px 0;\">\n                </div>\n                <div class=\"lbl mb-2.5\" data-kid=\"1-6-2-1-3\" style=\"color:var(--muted);\">\n                    bring them a question about\n                </div>\n                <p data-kid=\"1-6-2-1-4\" style=\"font-size:17px;line-height:1.5;\">\n                    Taking a prototype that works on one machine and making it survive real traffic — queues, storage, cost per request, and everything worth leaving out.\n                </p>\n            </div>\n            <div class=\"md:col-span-5 space-y-5\" data-kid=\"1-6-2-2\">\n                <div class=\"tp pnl p-6\" data-kid=\"1-6-2-2-1\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-6-2-2-1-1\">\n                        <img alt=\"Mentor portrait placeholder\" data-kid=\"1-6-2-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/300?u=h47-tx-research\" style=\"width:56px;height:56px;object-fit:cover;border-radius:8px;filter:grayscale(.6);\"/>\n                        <div class=\"flex-1\" data-kid=\"1-6-2-2-1-1-2\">\n                            <div class=\"font-medium\" data-kid=\"1-6-2-2-1-1-2-1\" style=\"font-size:17px;\">\n                                [mentor name]\n                            </div>\n                            <div class=\"lbl mt-1\" data-kid=\"1-6-2-2-1-1-2-2\" style=\"color:var(--muted);\">\n                                research scientist\n                            </div>\n                        </div>\n                        <span class=\"lbl\" data-kid=\"1-6-2-2-1-1-3\" style=\"color:var(--cyan);\">\n                            tx 02\n                        </span>\n                    </div>\n                    <div class=\"acc-body\" data-kid=\"1-6-2-2-1-2\">\n                        <div data-kid=\"1-6-2-2-1-2-1\">\n                            <p class=\"pt-5\" data-kid=\"1-6-2-2-1-2-1-1\" style=\"font-size:15px;line-height:1.5;color:var(--muted);\">\n                                Reading a paper properly, designing an evaluation you can trust, and knowing when a result is real rather than a lucky seed.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"tp pnl p-6\" data-kid=\"1-6-2-2-2\" style=\"margin-left:26px;\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-6-2-2-2-1\">\n                        <img alt=\"Mentor portrait placeholder\" data-kid=\"1-6-2-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/300?u=h47-tx-founder\" style=\"width:56px;height:56px;object-fit:cover;border-radius:8px;filter:grayscale(.6);\"/>\n                        <div class=\"flex-1\" data-kid=\"1-6-2-2-2-1-2\">\n                            <div class=\"font-medium\" data-kid=\"1-6-2-2-2-1-2-1\" style=\"font-size:17px;\">\n                                [mentor name]\n                            </div>\n                            <div class=\"lbl mt-1\" data-kid=\"1-6-2-2-2-1-2-2\" style=\"color:var(--muted);\">\n                                founder\n                            </div>\n                        </div>\n                        <span class=\"lbl\" data-kid=\"1-6-2-2-2-1-3\" style=\"color:var(--cyan);\">\n                            tx 03\n                        </span>\n                    </div>\n                    <div class=\"acc-body\" data-kid=\"1-6-2-2-2-2\">\n                        <div data-kid=\"1-6-2-2-2-2-1\">\n                            <p class=\"pt-5\" data-kid=\"1-6-2-2-2-2-1-1\" style=\"font-size:15px;line-height:1.5;color:var(--muted);\">\n                                Finding the first ten people who actually want the thing, and the difference between interest and use.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"tp pnl p-6\" data-kid=\"1-6-2-2-3\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-6-2-2-3-1\">\n                        <img alt=\"Mentor portrait placeholder\" data-kid=\"1-6-2-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/300?u=h47-tx-design\" style=\"width:56px;height:56px;object-fit:cover;border-radius:8px;filter:grayscale(.6);\"/>\n                        <div class=\"flex-1\" data-kid=\"1-6-2-2-3-1-2\">\n                            <div class=\"font-medium\" data-kid=\"1-6-2-2-3-1-2-1\" style=\"font-size:17px;\">\n                                [mentor name]\n                            </div>\n                            <div class=\"lbl mt-1\" data-kid=\"1-6-2-2-3-1-2-2\" style=\"color:var(--muted);\">\n                                product designer\n                            </div>\n                        </div>\n                        <span class=\"lbl\" data-kid=\"1-6-2-2-3-1-3\" style=\"color:var(--muted);\">\n                            tx 04\n                        </span>\n                    </div>\n                    <div class=\"acc-body\" data-kid=\"1-6-2-2-3-2\">\n                        <div data-kid=\"1-6-2-2-3-2-1\">\n                            <p class=\"pt-5\" data-kid=\"1-6-2-2-3-2-1-1\" style=\"font-size:15px;line-height:1.5;color:var(--muted);\">\n                                Making a rough tool legible to somebody who did not build it — naming, hierarchy, and cutting the second screen.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <p class=\"m mt-8\" data-kid=\"1-6-3\" style=\"font-size:13px;color:#5E7883;\">\n            Confirmed mentors are added to this roster as each one is announced. Select a panel to open it.\n        </p>\n    </section>\n    <!-- ===== 5. PARTNER SUPPORT MATRIX ===== -->\n    <section class=\"px-8 py-24 lg:py-32\" data-kid=\"1-7\" id=\"support\" style=\"background:var(--deck);\">\n        <div class=\"flex flex-wrap items-end justify-between gap-8 mb-14\" data-kid=\"1-7-1\">\n            <div data-kid=\"1-7-1-1\">\n                <div class=\"lbl mb-5\" data-kid=\"1-7-1-1-1\" style=\"color:var(--muted);\">\n                    05 / partner support\n                </div>\n                <h2 class=\"font-medium\" data-kid=\"1-7-1-1-2\" style=\"font-size:clamp(30px,3.8vw,52px);line-height:1.05;letter-spacing:-.03em;\">\n                    what is available to pilot 01 builders\n                </h2>\n            </div>\n            <a class=\"btn-c lbl px-5 py-2.5\" data-kid=\"1-7-1-2\" href=\"#\" style=\"text-decoration:none;\">\n                talk about supporting the house\n            </a>\n        </div>\n        <div class=\"pnl overflow-hidden\" data-kid=\"1-7-2\">\n            <div class=\"grid px-7 py-4\" data-kid=\"1-7-2-1\" style=\"grid-template-columns:1.1fr 2fr 92px 92px 92px;border-bottom:1px solid var(--bd);\">\n                <div class=\"lbl\" data-kid=\"1-7-2-1-1\" style=\"color:var(--muted);\">\n                    partner\n                </div>\n                <div class=\"lbl hidden md:block\" data-kid=\"1-7-2-1-2\" style=\"color:var(--muted);\">\n                    detail\n                </div>\n                <div class=\"lbl text-center\" data-kid=\"1-7-2-1-3\" style=\"color:var(--muted);\">\n                    credits\n                </div>\n                <div class=\"lbl text-center\" data-kid=\"1-7-2-1-4\" style=\"color:var(--muted);\">\n                    compute\n                </div>\n                <div class=\"lbl text-center\" data-kid=\"1-7-2-1-5\" style=\"color:var(--muted);\">\n                    capital\n                </div>\n            </div>\n            <div class=\"mx-row grid px-7 py-6 items-center\" data-kid=\"1-7-2-2\" style=\"grid-template-columns:1.1fr 2fr 92px 92px 92px;border-bottom:1px solid var(--bd);\">\n                <div class=\"font-medium\" data-kid=\"1-7-2-2-1\" style=\"font-size:19px;\">\n                    [partner one]\n                </div>\n                <div class=\"hidden md:block\" data-kid=\"1-7-2-2-2\" style=\"font-size:14px;line-height:1.5;color:var(--muted);max-width:440px;\">\n                    Model and API credits for every builder in the house, sized for a month of hard iteration.\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-2-3\">\n                    <span class=\"mx-dot\" data-kid=\"1-7-2-2-3-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-2-4\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-2-4-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-2-5\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-2-5-1\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"mx-row grid px-7 py-6 items-center\" data-kid=\"1-7-2-3\" style=\"grid-template-columns:1.1fr 2fr 92px 92px 92px;border-bottom:1px solid var(--bd);\">\n                <div class=\"font-medium\" data-kid=\"1-7-2-3-1\" style=\"font-size:19px;\">\n                    [partner two]\n                </div>\n                <div class=\"hidden md:block\" data-kid=\"1-7-2-3-2\" style=\"font-size:14px;line-height:1.5;color:var(--muted);max-width:440px;\">\n                    GPU time for training and evaluation runs, with engineering support on request.\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-3-3\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-3-3-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-3-4\">\n                    <span class=\"mx-dot\" data-kid=\"1-7-2-3-4-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-3-5\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-3-5-1\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"mx-row grid px-7 py-6 items-center\" data-kid=\"1-7-2-4\" style=\"grid-template-columns:1.1fr 2fr 92px 92px 92px;border-bottom:1px solid var(--bd);\">\n                <div class=\"font-medium\" data-kid=\"1-7-2-4-1\" style=\"font-size:19px;\">\n                    [partner three]\n                </div>\n                <div class=\"hidden md:block\" data-kid=\"1-7-2-4-2\" style=\"font-size:14px;line-height:1.5;color:var(--muted);max-width:440px;\">\n                    First-cheque conversations with builders who leave the house with something working.\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-4-3\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-4-3-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-4-4\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-4-4-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-4-5\">\n                    <span class=\"mx-dot\" data-kid=\"1-7-2-4-5-1\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"mx-row grid px-7 py-6 items-center\" data-kid=\"1-7-2-5\" style=\"grid-template-columns:1.1fr 2fr 92px 92px 92px;\">\n                <div class=\"font-medium\" data-kid=\"1-7-2-5-1\" style=\"font-size:19px;\">\n                    [partner four]\n                </div>\n                <div class=\"hidden md:block\" data-kid=\"1-7-2-5-2\" style=\"font-size:14px;line-height:1.5;color:var(--muted);max-width:440px;\">\n                    Developer tooling and analytics credits, plus a working session on instrumentation.\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-5-3\">\n                    <span class=\"mx-dot\" data-kid=\"1-7-2-5-3-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-5-4\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-5-4-1\">\n                    </span>\n                </div>\n                <div class=\"text-center\" data-kid=\"1-7-2-5-5\">\n                    <span class=\"mx-none\" data-kid=\"1-7-2-5-5-1\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <p class=\"m mt-6\" data-kid=\"1-7-3\" style=\"font-size:13px;color:#5E7883;\">\n            Only confirmed support is listed. Official logos appear here once each partner clears them.\n        </p>\n    </section>\n    <!-- ===== 6. HOUSE INFRASTRUCTURE ===== -->\n    <section class=\"px-8 py-24 lg:py-32\" data-kid=\"1-8\" id=\"house\" style=\"background:var(--slate);\">\n        <div class=\"lbl mb-14\" data-kid=\"1-8-1\" style=\"color:var(--muted);\">\n            06 / house infrastructure\n        </div>\n        <div class=\"relative pl-8\" data-kid=\"1-8-2\">\n            <div class=\"absolute\" data-kid=\"1-8-2-1\" style=\"left:0;top:8px;bottom:8px;width:1px;background:var(--bd);\">\n            </div>\n            <div class=\"absolute\" data-dynamic=\"true\" data-kid=\"1-8-2-2\" data-name=\"house infrastructure progress rail\" data-reason=\"height animated by scroll position\" id=\"railFill\" style=\"left:0;top:8px;width:1px;height:0;background:var(--cyan);\">\n            </div>\n            <div class=\"reveal pnl-r overflow-hidden mb-6\" data-kid=\"1-8-2-3\" style=\"max-width:940px;\">\n                <div class=\"grid md:grid-cols-[1fr_260px]\" data-kid=\"1-8-2-3-1\">\n                    <div class=\"p-8\" data-kid=\"1-8-2-3-1-1\">\n                        <div class=\"lbl mb-3\" data-kid=\"1-8-2-3-1-1-1\" style=\"color:var(--cyan);\">\n                            laundry / attention stays on work\n                        </div>\n                        <p data-kid=\"1-8-2-3-1-1-2\" style=\"font-size:18px;line-height:1.5;\">\n                            A working house keeps the ordinary maintenance moving. Clothes are handled so laundry never becomes another task competing with the work.\n                        </p>\n                    </div>\n                    <img alt=\"Well-equipped interior utility space, photograph by Elif on Pexels\" class=\"imgt w-full object-cover\" data-kid=\"1-8-2-3-1-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18177444/pexels-photo-18177444.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\" style=\"height:100%;min-height:150px;\"/>\n                </div>\n            </div>\n            <div class=\"reveal pnl-r overflow-hidden mb-6\" data-kid=\"1-8-2-4\" style=\"max-width:940px;margin-left:34px;\">\n                <div class=\"grid md:grid-cols-[1fr_260px]\" data-kid=\"1-8-2-4-1\">\n                    <div class=\"p-8\" data-kid=\"1-8-2-4-1-1\">\n                        <div class=\"lbl mb-3\" data-kid=\"1-8-2-4-1-1-1\" style=\"color:var(--cyan);\">\n                            food / reliable fuel for long days\n                        </div>\n                        <p data-kid=\"1-8-2-4-1-1-2\" style=\"font-size:18px;line-height:1.5;\">\n                            Meals are regular, practical, and shared when the day allows it. The kitchen is part of the working rhythm, not an afterthought.\n                        </p>\n                    </div>\n                    <img alt=\"Stainless steel kitchen surfaces, photograph by Cihan Yuce on Pexels\" class=\"imgt w-full object-cover\" data-kid=\"1-8-2-4-1-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12181753/pexels-photo-12181753.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\" style=\"height:100%;min-height:150px;\"/>\n                </div>\n            </div>\n            <div class=\"reveal pnl-r overflow-hidden\" data-kid=\"1-8-2-5\" style=\"max-width:940px;\">\n                <div class=\"grid md:grid-cols-[1fr_260px]\" data-kid=\"1-8-2-5-1\">\n                    <div class=\"p-8\" data-kid=\"1-8-2-5-1-1\">\n                        <div class=\"lbl mb-3\" data-kid=\"1-8-2-5-1-1-1\" style=\"color:var(--cyan);\">\n                            sleep / a house that supports recovery\n                        </div>\n                        <p data-kid=\"1-8-2-5-1-1-2\" style=\"font-size:18px;line-height:1.5;\">\n                            Long days happen. Recovery still matters. The house is organised so people can work intensely without treating exhaustion as a badge.\n                        </p>\n                    </div>\n                    <img alt=\"Dimly lit workspace at night, photograph by Justin Rieta on Pexels\" class=\"imgt w-full object-cover\" data-kid=\"1-8-2-5-1-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34110027/pexels-photo-34110027.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\" style=\"height:100%;min-height:150px;\"/>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ===== 7. DELHI OBSERVATIONS ===== -->\n    <section class=\"py-24 lg:py-32\" data-kid=\"1-9\" style=\"background:var(--deck);\">\n        <div class=\"px-8 lbl mb-12\" data-kid=\"1-9-1\" style=\"color:var(--muted);\">\n            07 / delhi observations\n        </div>\n        <div class=\"px-8 grid md:grid-cols-2 gap-5\" data-kid=\"1-9-2\">\n            <figure class=\"m-0\" data-kid=\"1-9-2-1\">\n                <div class=\"overflow-hidden\" data-kid=\"1-9-2-1-1\" style=\"border-radius:16px;height:420px;\">\n                    <img alt=\"Contemporary villa exterior at dusk, photograph by Pew Nguyen on Pexels\" class=\"par imgt w-full h-full object-cover\" data-kid=\"1-9-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/13573493/pexels-photo-13573493.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3.5\" data-kid=\"1-9-2-1-2\" style=\"color:var(--muted);\">\n                    01 / the house, from the lane\n                </figcaption>\n            </figure>\n            <figure class=\"m-0\" data-kid=\"1-9-2-2\">\n                <div class=\"overflow-hidden\" data-kid=\"1-9-2-2-1\" style=\"border-radius:16px;height:420px;\">\n                    <img alt=\"Inviting courtyard entrance, photograph by Jeremy Glineur on Pexels\" class=\"par imgt w-full h-full object-cover\" data-kid=\"1-9-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/16627395/pexels-photo-16627395.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3.5\" data-kid=\"1-9-2-2-2\" style=\"color:var(--muted);\">\n                    02 / courtyard after rain\n                </figcaption>\n            </figure>\n            <figure class=\"m-0\" data-kid=\"1-9-2-3\">\n                <div class=\"overflow-hidden\" data-kid=\"1-9-2-3-1\" style=\"border-radius:16px;height:300px;\">\n                    <img alt=\"Well-used desk with notebooks and lamp, photograph by Theo on Pexels\" class=\"par imgt w-full h-full object-cover\" data-kid=\"1-9-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/3414792/pexels-photo-3414792.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3.5\" data-kid=\"1-9-2-3-2\" style=\"color:var(--muted);\">\n                    03 / the work room\n                </figcaption>\n            </figure>\n            <figure class=\"m-0\" data-kid=\"1-9-2-4\">\n                <div class=\"overflow-hidden\" data-kid=\"1-9-2-4-1\" style=\"border-radius:16px;height:300px;\">\n                    <img alt=\"Quiet urban street at night, photograph by Erik Mclean on Pexels\" class=\"par imgt w-full h-full object-cover\" data-kid=\"1-9-2-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12748703/pexels-photo-12748703.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                </div>\n                <figcaption class=\"lbl mt-3.5\" data-kid=\"1-9-2-4-2\" style=\"color:var(--muted);\">\n                    04 / the street outside, 2am\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <!-- ===== 8. CONNECTED NODES ===== -->\n    <section class=\"px-8 py-24 lg:py-32\" data-kid=\"1-10\" id=\"network\" style=\"background:var(--slate);\">\n        <div class=\"lbl mb-6\" data-kid=\"1-10-1\" style=\"color:var(--muted);\">\n            08 / connected nodes\n        </div>\n        <h2 class=\"font-medium mb-20\" data-kid=\"1-10-2\" style=\"font-size:clamp(28px,3.6vw,48px);line-height:1.06;letter-spacing:-.03em;max-width:560px;\">\n            a network built room by room.\n        </h2>\n        <div class=\"relative\" data-kid=\"1-10-3\">\n            <div class=\"absolute hidden md:block\" data-kid=\"1-10-3-1\" style=\"left:8px;right:8px;top:11px;height:1px;background:var(--bd);\">\n            </div>\n            <div class=\"absolute hidden md:block\" data-dynamic=\"true\" data-kid=\"1-10-3-2\" data-name=\"network progress line\" data-reason=\"width animated by scroll position\" id=\"netFill\" style=\"left:8px;top:11px;height:1px;width:0;background:var(--cyan);\">\n            </div>\n            <div class=\"grid md:grid-cols-4 gap-y-12\" data-kid=\"1-10-3-3\">\n                <div data-kid=\"1-10-3-3-1\">\n                    <span data-kid=\"1-10-3-3-1-1\" style=\"width:22px;height:22px;border-radius:999px;background:var(--cyan);display:block;box-shadow:0 0 0 6px rgba(84,213,192,.14);\">\n                    </span>\n                    <div class=\"font-medium mt-6\" data-kid=\"1-10-3-3-1-2\" style=\"font-size:20px;\">\n                        delhi / hack47\n                    </div>\n                    <div class=\"lbl mt-2\" data-kid=\"1-10-3-3-1-3\" style=\"color:var(--cyan);\">\n                        active · pilot 01\n                    </div>\n                </div>\n                <div data-kid=\"1-10-3-3-2\">\n                    <span data-kid=\"1-10-3-3-2-1\" style=\"width:22px;height:22px;border-radius:999px;border:1px solid var(--cyan);display:block;\">\n                    </span>\n                    <a class=\"font-medium mt-6 block\" data-kid=\"1-10-3-3-2-2\" href=\"https://variance.house\" style=\"font-size:20px;color:var(--ink);text-decoration:none;\">\n                        variance.house\n                        <span class=\"ti ti-external-link\" data-kid=\"1-10-3-3-2-2-1\" style=\"font-size:15px;color:var(--cyan);\">\n                        </span>\n                    </a>\n                    <div class=\"lbl mt-2\" data-kid=\"1-10-3-3-2-3\" style=\"color:var(--muted);\">\n                        sister house\n                    </div>\n                </div>\n                <div data-kid=\"1-10-3-3-3\">\n                    <span data-kid=\"1-10-3-3-3-1\" style=\"width:22px;height:22px;border-radius:999px;border:1px solid #2C424C;display:block;\">\n                    </span>\n                    <div class=\"font-medium mt-6\" data-kid=\"1-10-3-3-3-2\" style=\"font-size:20px;color:#4C6672;\">\n                        next node\n                    </div>\n                    <div class=\"lbl mt-2\" data-kid=\"1-10-3-3-3-3\" style=\"color:#3E5762;\">\n                        unannounced\n                    </div>\n                </div>\n                <div data-kid=\"1-10-3-3-4\">\n                    <span data-kid=\"1-10-3-3-4-1\" style=\"width:22px;height:22px;border-radius:999px;border:1px solid #2C424C;display:block;\">\n                    </span>\n                    <div class=\"font-medium mt-6\" data-kid=\"1-10-3-3-4-2\" style=\"font-size:20px;color:#4C6672;\">\n                        next node\n                    </div>\n                    <div class=\"lbl mt-2\" data-kid=\"1-10-3-3-4-3\" style=\"color:#3E5762;\">\n                        unannounced\n                    </div>\n                </div>\n            </div>\n        </div>\n        <p class=\"m mt-14\" data-kid=\"1-10-4\" style=\"font-size:13px;color:#5E7883;\">\n            Next city nodes are being worked on. Nothing announced until a house is signed.\n        </p>\n    </section>\n    <!-- ===== 9. APPLY ===== -->\n    <section class=\"px-8 text-center\" data-kid=\"1-11\" id=\"apply\" style=\"background:#050A0F;padding-top:140px;padding-bottom:140px;\">\n        <h2 class=\"font-medium mx-auto\" data-kid=\"1-11-1\" style=\"font-size:clamp(30px,4.2vw,58px);line-height:1.08;letter-spacing:-.03em;max-width:760px;\">\n            If the work is already underway, request a place.\n        </h2>\n        <a class=\"btn-c lbl inline-block mt-12 px-9 py-4\" data-kid=\"1-11-2\" href=\"#\" style=\"text-decoration:none;\">\n            request a place →\n        </a>\n        <div class=\"lbl mt-8\" data-kid=\"1-11-3\" style=\"color:var(--muted);\">\n            pilot 01 · delhi · 16 places · sept 15 — oct 15\n        </div>\n    </section>\n    <!-- ===== FOOTER ===== -->\n    <footer class=\"px-8 pt-16 pb-10\" data-kid=\"1-12\" style=\"background:var(--slate);border-top:1px solid var(--bd);\">\n        <div class=\"flex flex-wrap justify-between gap-12\" data-kid=\"1-12-1\">\n            <div data-kid=\"1-12-1-1\">\n                <div class=\"flex items-center gap-2.5 mb-4\" data-kid=\"1-12-1-1-1\">\n                    <span data-kid=\"1-12-1-1-1-1\" style=\"width:12px;height:12px;border-radius:999px;background:var(--cyan);display:inline-block;\">\n                    </span>\n                    <span class=\"text-[17px] font-semibold tracking-tight\" data-kid=\"1-12-1-1-1-2\">\n                        hack47\n                    </span>\n                </div>\n                <p data-kid=\"1-12-1-1-2\" style=\"font-size:13px;line-height:1.6;color:var(--muted);max-width:260px;\">\n                    A thirty-day builder residency in a Delhi villa. Pilot cohort, sixteen places.\n                </p>\n            </div>\n            <div class=\"flex gap-14 flex-wrap\" data-kid=\"1-12-1-2\">\n                <div data-kid=\"1-12-1-2-1\">\n                    <div class=\"lbl mb-4\" data-kid=\"1-12-1-2-1-1\" style=\"color:#4C6672;\">\n                        pilot 01\n                    </div>\n                    <ul class=\"space-y-2.5\" data-kid=\"1-12-1-2-1-2\" style=\"list-style:none;padding:0;font-size:14px;\">\n                        <li data-kid=\"1-12-1-2-1-2-1\">\n                            <a class=\"tlink\" data-kid=\"1-12-1-2-1-2-1-1\" href=\"#mentors\">\n                                mentors\n                            </a>\n                        </li>\n                        <li data-kid=\"1-12-1-2-1-2-2\">\n                            <a class=\"tlink\" data-kid=\"1-12-1-2-1-2-2-1\" href=\"#support\">\n                                partners\n                            </a>\n                        </li>\n                        <li data-kid=\"1-12-1-2-1-2-3\">\n                            <a class=\"tlink\" data-kid=\"1-12-1-2-1-2-3-1\" href=\"#house\">\n                                the house\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-12-1-2-2\">\n                    <div class=\"lbl mb-4\" data-kid=\"1-12-1-2-2-1\" style=\"color:#4C6672;\">\n                        elsewhere\n                    </div>\n                    <ul class=\"space-y-2.5\" data-kid=\"1-12-1-2-2-2\" style=\"list-style:none;padding:0;font-size:14px;\">\n                        <li data-kid=\"1-12-1-2-2-2-1\">\n                            <a class=\"tlink\" data-kid=\"1-12-1-2-2-2-1-1\" href=\"https://variance.house\">\n                                variance.house ↗\n                            </a>\n                        </li>\n                        <li data-kid=\"1-12-1-2-2-2-2\">\n                            <a class=\"tlink\" data-kid=\"1-12-1-2-2-2-2-1\" href=\"#\">\n                                x ↗\n                            </a>\n                        </li>\n                        <li data-kid=\"1-12-1-2-2-2-3\">\n                            <a class=\"tlink\" data-kid=\"1-12-1-2-2-2-3-1\" href=\"mailto:hello@hack47.org\">\n                                hello@hack47.org\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"1-12-2\" style=\"height:1px;background:var(--bd);margin:34px 0 18px;\">\n        </div>\n        <div class=\"flex flex-wrap justify-between gap-4 lbl\" data-kid=\"1-12-3\" style=\"color:#425B66;\">\n            <div data-kid=\"1-12-3-1\">\n                delhi · © 2026 hack47\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"1-12-3-2\">\n                <a data-kid=\"1-12-3-2-1\" href=\"#\" style=\"color:inherit;text-decoration:none;\">\n                    code of conduct\n                </a>\n                <a data-kid=\"1-12-3-2-2\" href=\"#\" style=\"color:inherit;text-decoration:none;\">\n                    privacy\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n/* ---------- intake field canvas ---------- */\n(function(){\n  var c = document.getElementById('field');\n  if(!c) return;\n  var ctx = c.getContext('2d'), dpr = Math.min(window.devicePixelRatio||1, 2);\n  var pts = [], W = 0, H = 0, mx = 0, my = 0;\n\n  function resize(){\n    W = c.clientWidth; H = c.clientHeight;\n    c.width = W*dpr; c.height = H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);\n    build();\n  }\n  function build(){\n    pts = [];\n    var n = Math.min(1500, Math.round(W*H/900));\n    for(var i=0;i<n;i++){\n      var layer = i%3;\n      pts.push({\n        x: Math.random()*W, y: Math.random()*H,\n        r: layer===2 ? 1.7 : (layer===1 ? 1.2 : .8),\n        a: 0.10 + Math.random()*(layer===2?.55:.3),\n        vx: (Math.random()-.5)*.14, vy: (Math.random()-.5)*.10,\n        layer: layer, sel: false\n      });\n    }\n    /* 16 chosen signals, clustered mid-right */\n    for(var k=0;k<16;k++){\n      var p = pts[Math.floor(Math.random()*pts.length)];\n      if(p){ p.sel = true; p.r = 2.6; p.a = .95; }\n    }\n  }\n  var t0 = performance.now(), running = true, visible = true;\n  function draw(){\n    ctx.clearRect(0,0,W,H);\n    for(var i=0;i<pts.length;i++){\n      var p = pts[i];\n      p.x += p.vx; p.y += p.vy;\n      if(p.x<0) p.x=W; if(p.x>W) p.x=0;\n      if(p.y<0) p.y=H; if(p.y>H) p.y=0;\n      var off = (p.layer+1) * 1.4;\n      var px = p.x + mx*off, py = p.y + my*off;\n      ctx.beginPath();\n      ctx.arc(px, py, p.r, 0, 6.2832);\n      ctx.fillStyle = p.sel ? 'rgba(214,113,72,'+p.a+')' : 'rgba(84,213,192,'+p.a+')';\n      ctx.fill();\n    }\n    /* bounded loop: drift settles after 14s and pauses when the hero leaves view,\n       so the field never holds an endless render loop */\n    if(running && visible && (performance.now() - t0) < 14000) requestAnimationFrame(draw);\n    else running = false;\n  }\n  if(window.IntersectionObserver){\n    new IntersectionObserver(function(e){\n      visible = e[0].isIntersecting;\n      if(visible && !running && (performance.now() - t0) < 14000){ running = true; requestAnimationFrame(draw); }\n    }, { threshold: 0 }).observe(c);\n  }\n  window.addEventListener('resize', resize);\n  document.getElementById('hero').addEventListener('mousemove', function(e){\n    var r = c.getBoundingClientRect();\n    mx = ((e.clientX - r.left)/r.width - .5) * 3;\n    my = ((e.clientY - r.top)/r.height - .5) * 3;\n  });\n  resize(); draw();\n})();\n\n/* ---------- selection hold ---------- */\nScrollTrigger.create({ trigger: '#selection', start: 'top top', end: '+=55%', pin: true, pinSpacing: true });\n\n/* ---------- 4x4 plan grid ---------- */\n(function(){\n  var g = document.getElementById('planGrid');\n  if(!g) return;\n  for(var i=0;i<16;i++){\n    var d = document.createElement('div');\n    d.className = 'plan-cell cell';\n    d.style.aspectRatio = '1 / 1.15';\n    d.style.borderRadius = '3px';\n    g.appendChild(d);\n    var inner = document.createElement('div');\n  }\n})();\ngsap.utils.toArray('.plan-cell').forEach(function(el, i){\n  gsap.to(el, {\n    scrollTrigger: { trigger: '#selection', start: 'top 68%' },\n    backgroundColor: '#D67148', borderColor: '#D67148',\n    duration: .45, delay: i*0.055, ease: 'none'\n  });\n});\n\n/* ---------- header ---------- */\nScrollTrigger.create({ start: 'top -50', end: 99999, onUpdate: function(s){\n  var h = document.getElementById('hdr');\n  if(s.scroll() > 50){ h.style.background = '#111B23'; h.style.borderBottomColor = '#29404B'; }\n  else { h.style.background = 'transparent'; h.style.borderBottomColor = 'transparent'; }\n}});\n\n/* ---------- hero copy ---------- */\ngsap.from('#h1', { y: 30, opacity: 0, duration: 1.05, ease: 'power3.out', delay: .2 });\ngsap.from('#hero .pnl', { y: 20, opacity: 0, duration: .9, ease: 'power2.out', delay: .5 });\n\n/* ---------- side index ---------- */\n(function(){\n  var items = gsap.utils.toArray('.idx-item');\n  items.forEach(function(it){\n    var t = document.querySelector(it.dataset.t);\n    if(!t) return;\n    ScrollTrigger.create({\n      trigger: t, start: 'top 45%', end: 'bottom 45%',\n      onToggle: function(self){\n        if(self.isActive){\n          items.forEach(function(x){ x.classList.remove('on'); });\n          it.classList.add('on');\n        }\n      }\n    });\n  });\n  gsap.to('#idxBar', { height: '100%', ease: 'none', scrollTrigger: { trigger: document.documentElement, start: 'top top', end: 'bottom bottom', scrub: .5 } });\n})();\n\n/* ---------- reveals ---------- */\ngsap.utils.toArray('.reveal').forEach(function(el){\n  gsap.from(el, { scrollTrigger: { trigger: el, start: 'top 86%' }, y: 24, opacity: 0, duration: .8, ease: 'power2.out' });\n});\n\n/* ---------- house rail ---------- */\ngsap.to('#railFill', { height: '100%', ease: 'none', scrollTrigger: { trigger: '#house', start: 'top 62%', end: 'bottom 85%', scrub: .6 } });\n\n/* ---------- mentor panels ---------- */\ndocument.querySelectorAll('.tp').forEach(function(p){\n  p.addEventListener('click', function(){\n    var isSel = p.classList.contains('sel');\n    document.querySelectorAll('.tp').forEach(function(x){ x.classList.remove('sel'); });\n    if(!isSel) p.classList.add('sel');\n    ScrollTrigger.refresh();\n  });\n});\n\n/* ---------- photo parallax ---------- */\ngsap.utils.toArray('.par').forEach(function(img){\n  gsap.fromTo(img, { y: -10 }, { y: 10, ease: 'none', scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true } });\n});\n\n/* ---------- network line ---------- */\ngsap.to('#netFill', { width: 'calc(100% - 16px)', ease: 'none', scrollTrigger: { trigger: '#network', start: 'top 65%', end: 'bottom 85%', scrub: .8 } });\n</script>\n",
      "comments": [],
      "created": "2026-09-11T04:28:07.273240+00:00",
      "modified": "2026-09-11T04:34:48.637187+00:00",
